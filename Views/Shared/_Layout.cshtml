@inject MenuScan.Services.ITenantService TenantService
@inject MenuScan.Data.ApplicationDbContext AppDb
@using Microsoft.EntityFrameworkCore
@{
    var tenantId = TenantService.CurrentRestaurantId;
    var currentRestaurant = tenantId.HasValue 
        ? AppDb.Restaurants.IgnoreQueryFilters().FirstOrDefault(r => r.Id == tenantId.Value) 
        : null;
    var brandName = currentRestaurant?.Name ?? "Brew & Bliss";
    var primaryTableToken = currentRestaurant != null
        ? AppDb.DiningTables.IgnoreQueryFilters().Where(t => t.RestaurantId == currentRestaurant.Id).Select(t => t.Token).FirstOrDefault() ?? "TAB-01"
        : "TAB-01";
    var primarySlug = currentRestaurant?.Slug ?? "spice-symphony";
    var customerMenuUrl = $"/r/{primarySlug}/t/{primaryTableToken}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @brandName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100" style="background-color: var(--cafe-bg);">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm py-2" style="background-color: #241812; border-bottom: 2px solid #3D291F;">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="fs-4 me-2">☕</span>
                    <span style="letter-spacing: -0.5px;">@brandName</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="@customerMenuUrl"><i class="bi bi-phone me-1"></i>Customer QR Menu</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-bold" asp-controller="SuperAdmin" asp-action="Index">
                                        <i class="bi bi-buildings me-1"></i>Platform SaaS
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("RestaurantAdmin") || User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Tables"><i class="bi bi-grid-3x3-gap me-1"></i>Tables & QRs</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Menu"><i class="bi bi-menu-button-wide me-1"></i>Menu</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Reports" asp-action="DailySales"><i class="bi bi-graph-up me-1"></i>Reports</a>
                                </li>
                            }
                            @if (User.IsInRole("RestaurantAdmin") || User.IsInRole("Cashier") || User.IsInRole("KitchenStaff") || User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-info fw-semibold" asp-controller="FloorPlan" asp-action="Index">
                                        <i class="bi bi-diagram-3 me-1"></i>Floor Plan
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("KitchenStaff") || User.IsInRole("RestaurantAdmin") || User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-semibold" asp-controller="Kitchen" asp-action="Index">
                                        <i class="bi bi-fire me-1"></i>Kitchen KDS
                                    </a>
                                </li>
                            }
                            @if (User.IsInRole("Cashier") || User.IsInRole("RestaurantAdmin") || User.IsInRole("SuperAdmin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-success fw-semibold" asp-controller="Billing" asp-action="Index">
                                        <i class="bi bi-cash-stack me-1"></i>Billing & Cashier
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3 text-white small">
                                <i class="bi bi-person-circle me-1" style="color: var(--cafe-primary);"></i> @User.Identity.Name
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-cafe-primary btn-sm px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-shield-lock me-1"></i> Staff Portal
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 border-top text-center text-muted small" style="background-color: #FFFFFF; border-color: var(--cafe-border) !important;">
        <div class="container">
            &copy; @DateTime.UtcNow.Year Brew &amp; Bliss Coffee House • Powered by MenuScan
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
