            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success fw-bold px-4" id="btnConfirmSettlement" onclick="confirmPayment()">
                    Confirm Payment & Generate Receipt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Staff WhatsApp Notification Modal (Browser WhatsApp Web) -->
<div class="modal fade" id="staffWhatsAppModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-success text-white py-3">
                <h6 class="modal-title fw-bold"><i class="bi bi-whatsapp me-2"></i>Send WhatsApp Update (Browser)</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="mb-3 text-start">
                    <label class="form-label small fw-semibold text-muted">Customer Mobile Number:</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">+91</span>
                        <input type="tel" id="staffWpPhoneInput" class="form-control font-monospace fw-bold" placeholder="10-digit mobile" maxlength="10" />
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <button class="btn btn-outline-success text-start p-3 rounded-3 d-flex align-items-center gap-3" onclick="triggerBrowserWhatsApp('confirm')">
                        <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                        <div>
                            <div class="fw-bold">1. Order Confirmation</div>
                            <small class="text-muted">Sends live order tracking link &amp; items summary</small>
                        </div>
                    </button>
                    <button class="btn btn-outline-primary text-start p-3 rounded-3 d-flex align-items-center gap-3" onclick="triggerBrowserWhatsApp('ready')">
                        <i class="bi bi-bell-fill fs-3 text-primary"></i>
                        <div>
                            <div class="fw-bold">2. Food is Ready &amp; Serving</div>
                            <small class="text-muted">Notifies diner that food is prepared</small>
                        </div>
                    </button>
                    <button class="btn btn-outline-dark text-start p-3 rounded-3 d-flex align-items-center gap-3" onclick="triggerBrowserWhatsApp('bill')">
                        <i class="bi bi-receipt fs-3 text-dark"></i>
                        <div>
                            <div class="fw-bold">3. Official Tax Receipt</div>
                            <small class="text-muted">Sends digital tax receipt URL (after settlement)</small>
                        </div>
                    </button>
                </div>
                <small class="text-muted d-block mt-3">
                    <i class="bi bi-browser-chrome me-1"></i>Opens WhatsApp Web directly in your browser. No Meta Cloud API needed.
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const restaurantId = "@restaurantId";
        let currentModal;
        let activeStaffOrderId = null;
        let staffWpModalInstance;

        function getAntiForgeryToken() {
            const meta = document.querySelector('meta[name="antiforgery-token"]');
            return meta ? meta.getAttribute('content') : '';
        }

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-instant-approve');
            if (btn) {
                const orderId = btn.getAttribute('data-order-id');
                const orderNum = btn.getAttribute('data-order-num') || '';
                const tableNum = btn.getAttribute('data-table-num') || '';
                const amount = parseFloat(btn.getAttribute('data-amount') || '0');
                const reqId = btn.getAttribute('data-req-id') || '';
                instantApprovePayment(orderId, orderNum, tableNum, amount, reqId);
            }
        });

        function openStaffWhatsAppModal(orderToken, phone, defaultType = 'confirm') {
            activeStaffOrderId = orderToken;
            const input = document.getElementById('staffWpPhoneInput');
            if (input) {
                input.value = phone ? (phone.startsWith('91') ? phone.substring(2) : phone) : '';
            }
            if (!staffWpModalInstance) {
                staffWpModalInstance = new bootstrap.Modal(document.getElementById('staffWhatsAppModal'));
            }
            staffWpModalInstance.show();
        }

        async function triggerBrowserWhatsApp(type) {
            const input = document.getElementById('staffWpPhoneInput');
            const phone = input ? input.value.trim() : '';

            try {
                const res = await fetch(`/api/order/whatsapp-link?orderToken=${encodeURIComponent(activeStaffOrderId)}&type=${encodeURIComponent(type)}&phone=${encodeURIComponent(phone)}`);
                const data = await res.json();
                if (res.ok && data.url) {
                    window.open(data.url, '_blank');
                    if (staffWpModalInstance) staffWpModalInstance.hide();
                } else {
                    alert(data.message || "Failed to generate WhatsApp link.");
                }
            } catch (e) {
                console.error(e);
                alert("Network error.");
            }
        }

        function openSettleModal(orderId, orderNum, tableNum, subTotal, tax, total) {
            document.getElementById('settleOrderId').value = orderId;
            document.getElementById('settleOrderNumberText').innerText = orderNum;
            document.getElementById('settleTableBadge').innerText = tableNum;
            document.getElementById('settleSubTotalText').innerText = subTotal.toFixed(2);
            document.getElementById('settleTaxText').innerText = tax.toFixed(2);
            document.getElementById('settleTotalText').innerText = total.toFixed(2);

            currentModal = new bootstrap.Modal(document.getElementById('settleModal'));
            currentModal.show();
        }

        function openSettleWithUtr(orderId, orderNum, tableNum, subTotal, tax, total, utr) {
            openSettleModal(orderId, orderNum, tableNum, subTotal, tax, total);
            const methodSelect = document.getElementById('paymentMethodSelect');
            const refInput = document.getElementById('paymentReferenceInput');
            if (methodSelect) methodSelect.value = "1"; // UPI
            if (refInput && utr) refInput.value = `UTR-${utr}`;
        }

        async function instantApprovePayment(orderId, orderNum, tableNum, amount, reqId) {
            const confirmed = confirm(`Table ${tableNum} (Order #${orderNum}) ka UPI Payment approve karein?\n\nAmount: ₹${Number(amount).toFixed(2)}\n\nIsse bill PAID mark ho jayega aur customer ke phone pe Tax Receipt unlock ho jayegi.`);
            if (!confirmed) return;

            try {
                const response = await fetch('/Billing/SettleBill', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        orderId: orderId,
                        method: 1, // UPI
                        reference: 'UPI-VERIFIED'
                    })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    playCashierChime();
                    if (reqId) {
                        const reqCard = document.getElementById(`req-card-${reqId}`);
                        if (reqCard) reqCard.remove();
                    }
                    if (data.whatsAppUrl) {
                        const sendWp = confirm("Payment approved! Bill settled. Would you like to open WhatsApp Web to send receipt?");
                        if (sendWp) {
                            window.open(data.whatsAppUrl, '_blank');
                        }
                    }
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to settle bill.");
                }
            } catch (err) {
                console.error(err);
                alert("Network error approving payment.");
            }
        }

        async function confirmPayment() {
            const orderId = document.getElementById('settleOrderId').value;
            const method = parseInt(document.getElementById('paymentMethodSelect').value);
            const ref = document.getElementById('paymentReferenceInput').value;
            const btn = document.getElementById('btnConfirmSettlement');

            btn.disabled = true;
            btn.innerText = "Processing...";

            try {
                const response = await fetch('/Billing/SettleBill', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({
                        orderId: orderId,
                        method: method,
                        reference: ref
                    })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    currentModal.hide();
                    // Open print receipt in new window
                    window.open(data.receiptUrl, '_blank');
                    // Prompt for WhatsApp Web receipt dispatch
                    if (data.whatsAppUrl) {
                        const sendWp = confirm("Bill settled! Would you like to open WhatsApp Web to send receipt to " + (data.customerPhone || "customer") + "?");
                        if (sendWp) {
                            window.open(data.whatsAppUrl, '_blank');
                        }
                    }
                    // Reload table
                    window.location.reload();
                } else {
                    alert(data.message || "Failed to settle bill.");
                    btn.disabled = false;
                    btn.innerText = "Confirm Payment & Generate Receipt";
                }
            } catch (err) {
                console.error(err);
                alert("Network error.");
                btn.disabled = false;
                btn.innerText = "Confirm Payment & Generate Receipt";
            }
        }

        // Web Audio Chime synthesizer
        function playCashierChime() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const now = ctx.currentTime;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(659.25, now); // E5
                osc.frequency.setValueAtTime(880.00, now + 0.12); // A5
                osc.frequency.setValueAtTime(1046.50, now + 0.25); // C6
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.6);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.6);
            } catch (e) {
                console.log("Audio alert blocked by browser autoplay policy.");
            }
        }

        async function acknowledgeService(requestId) {
            try {
                const response = await fetch('/Billing/AcknowledgeServiceRequest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(requestId)
                });

                if (response.ok) {
                    const el = document.getElementById(`req-card-${requestId}`);
                    if (el) {
                        el.style.transition = "opacity 0.3s ease, height 0.3s ease";
                        el.style.opacity = "0";
                        setTimeout(() => el.remove(), 300);
                    }
                } else {
                    alert("Could not update request.");
                }
            } catch (e) {
                console.error(e);
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // SignalR Auto-refresh on new orders & waiter calls
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/order")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveNewOrder", (order) => {
            console.log("New order notified to Cashier:", order);
            MenuScanSoundbox.announceNewOrder(order.tableNumber, order.totalAmount, order.itemCount);
            const badge = document.querySelector('.badge.bg-primary');
            if (badge) {
                badge.classList.add('animate__animated', 'animate__pulse');
            }
            setTimeout(() => window.location.reload(), 1500);
        });

        connection.on("ReceivePaymentSettled", (data) => {
            console.log("Payment settled notification received in Cashier:", data);
            MenuScanSoundbox.announcePayment(data.tableNumber, data.amount, data.method);
            setTimeout(() => window.location.reload(), 1500);
        });

        connection.on("ReceiveWaiterCall", (data) => {
            console.log("Waiter call received in Cashier:", data);
            MenuScanSoundbox.announceServiceCall(data.tableNumber, data.requestType);

            const container = document.getElementById('cashierWaiterAlertContainer');
            let list = document.getElementById('pendingRequestList');
            if (!list) {
                container.innerHTML = `
                    <div class="card border-warning bg-warning-subtle rounded-3 shadow-sm mb-3">
                        <div class="card-header bg-warning text-dark fw-bold d-flex justify-content-between align-items-center py-2">
                            <span><i class="bi bi-bell-fill me-2"></i>Pending Table Service Requests</span>
                            <span class="badge bg-dark" id="pendingCallCount">1 Pending</span>
                        </div>
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush rounded-bottom-3" id="pendingRequestList"></ul>
                        </div>
                    </div>
                `;
                list = document.getElementById('pendingRequestList');
            }

            const icon = data.requestType === "Water" ? "💧" : data.requestType === "Cutlery" ? "🍴" : data.requestType === "Bill" ? "💳" : data.requestType === "UPI Payment" ? "💰" : "🛎️";
            const safeTable = escapeHtml(data.tableNumber);
            const safeType = escapeHtml(data.requestType);
            const safeNotes = escapeHtml(data.notes);
            const safeCreated = escapeHtml(data.createdAt);

            const itemHtml = `
                <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent py-3 animate__animated animate__fadeInDown" id="req-card-${data.requestId}">
                    <div class="d-flex align-items-center gap-3">
                        <span class="fs-4">${icon}</span>
                        <div>
                            <span class="badge bg-dark fs-6">${safeTable}</span>
                            <strong class="ms-2">${safeType} ${data.requestType === "UPI Payment" ? "Verification" : "Requested"}</strong>
                            ${safeNotes ? `<div class="small text-muted mt-1"><i class="bi bi-chat-left-dots me-1"></i>${safeNotes}</div>` : ''}
                            <div class="text-muted small"><i class="bi bi-clock me-1"></i>${safeCreated}</div>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        ${data.requestType === "UPI Payment" && data.orderId ? `
                            <button type="button" class="btn btn-success btn-sm rounded-pill px-3 fw-bold shadow-sm btn-instant-approve"
                                    data-order-id="${escapeHtml(data.orderId)}"
                                    data-order-num=""
                                    data-table-num="${safeTable}"
                                    data-amount="${Number(data.totalAmount || 0)}"
                                    data-req-id="${escapeHtml(data.requestId)}">
                                <i class="bi bi-check-circle-fill me-1"></i> Approve Payment
                            </button>
                        ` : ''}
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="acknowledgeService('${data.requestId}')">
                            <i class="bi bi-check2 me-1"></i> Mark Handled
                        </button>
                    </div>
                </li>
            `;
            list.insertAdjacentHTML('afterbegin', itemHtml);

            if (data.requestType === "UPI Payment") {
                // Auto reload active orders table so cashier gets the 1-click verify button
                setTimeout(() => window.location.reload(), 1500);
            }
        });

        connection.start().then(() => {
            connection.invoke("JoinRestaurantGroup", restaurantId);
        });

        let dayEndData = null;

        async function openDayEndWhatsAppModal() {
            const modalEl = document.getElementById('dayEndWhatsAppModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            const phoneInput = document.getElementById('ownerWpPhoneInput');
            const phone = phoneInput ? phoneInput.value.trim() : '';

            try {
                const res = await fetch(`/api/reports/daily-sales-summary?phone=${encodeURIComponent(phone)}`);
                const data = await res.json();
                if (res.ok && data.success) {
                    dayEndData = data;
                    if (data.ownerPhone && phoneInput && !phoneInput.value) {
                        phoneInput.value = data.ownerPhone.replace(/\D/g, '').slice(-10);
                    }
                    const preview = document.getElementById('dayEndReportPreview');
                    if (preview) preview.innerText = data.summaryText;
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function refreshDayEndPreview() {
            const phoneInput = document.getElementById('ownerWpPhoneInput');
            const phone = phoneInput ? phoneInput.value.trim() : '';
            try {
                const res = await fetch(`/api/reports/daily-sales-summary?phone=${encodeURIComponent(phone)}`);
                const data = await res.json();
                if (res.ok && data.success) {
                    dayEndData = data;
                    const preview = document.getElementById('dayEndReportPreview');
                    if (preview) preview.innerText = data.summaryText;
                }
            } catch (e) {
                console.error(e);
            }
        }

        function sendOwnerWhatsAppReport() {
            const phoneInput = document.getElementById('ownerWpPhoneInput');
            const phone = phoneInput ? phoneInput.value.trim() : '';
            if (!phone || phone.length < 10) {
                alert("Please enter a valid 10-digit mobile number.");
                return;
            }

            if (dayEndData && dayEndData.summaryText) {
                const clean = phone.replace(/\D/g, '');
                const cleanPhone = clean.length === 10 ? `91${clean}` : clean;
                const url = `https://web.whatsapp.com/send?phone=${cleanPhone}&text=${encodeURIComponent(dayEndData.summaryText)}`;
                window.open(url, '_blank');
                const modalEl = document.getElementById('dayEndWhatsAppModal');
                if (modalEl) bootstrap.Modal.getOrCreateInstance(modalEl).hide();
            }
        }

        function copyReportText() {
            if (dayEndData && dayEndData.summaryText) {
                navigator.clipboard.writeText(dayEndData.summaryText).then(() => {
                    alert("Daily sales summary copied to clipboard!");
                });
            }
        }
    </script>
}

