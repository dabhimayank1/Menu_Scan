@model List<MenuScan.Models.Entities.Bill>
@{
    ViewData["Title"] = "Daily Sales Report";
    Layout = "_Layout";
    var restaurant = (MenuScan.Models.Entities.Restaurant)ViewBag.Restaurant;
    var itemPopularity = (IEnumerable<dynamic>)ViewBag.ItemPopularity;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Daily Sales & Settlement Report</h3>
            <p class="text-muted mb-0">@restaurant.Name - @DateTime.Now.ToString("dddd, MMMM dd, yyyy")</p>
        </div>
        <button class="btn btn-outline-dark" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> Print Daily Summary
        </button>
    </div>

    <!-- Summary KPI cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <small class="text-muted text-uppercase fw-semibold">Net Settled Sales</small>
                <h3 class="fw-bold text-success mb-0 mt-1">₹@(((decimal)ViewBag.TotalSales).ToString("0.00"))</h3>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <small class="text-muted text-uppercase fw-semibold">Total Orders Settled</small>
                <h3 class="fw-bold text-primary mb-0 mt-1">@ViewBag.TotalBills</h3>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <small class="text-muted text-uppercase fw-semibold">Avg. Order Value (AOV)</small>
                <h3 class="fw-bold text-dark mb-0 mt-1">₹@(((decimal)ViewBag.AvgOrderValue).ToString("0.00"))</h3>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                <small class="text-muted text-uppercase fw-semibold">Total Tax / GST</small>
                <h3 class="fw-bold text-secondary mb-0 mt-1">₹@(((decimal)ViewBag.TotalTax).ToString("0.00"))</h3>
            </div>
        </div>
    </div>

    <!-- Payment Breakdown & Popular Items -->
    <div class="row g-4 mb-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-pie-chart me-2 text-primary"></i>Payment Method Split</h5>
                </div>
                <div class="card-body p-3">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="badge bg-success-subtle text-success me-2">UPI</span>
                                <span class="fw-semibold">Digital UPI Payments</span>
                            </div>
                            <span class="fw-bold fs-6">₹@(((decimal)ViewBag.UpiTotal).ToString("0.00"))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="badge bg-primary-subtle text-primary me-2">CASH</span>
                                <span class="fw-semibold">Counter Cash</span>
                            </div>
                            <span class="fw-bold fs-6">₹@(((decimal)ViewBag.CashTotal).ToString("0.00"))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                            <div>
                                <span class="badge bg-warning-subtle text-warning text-dark me-2">CARD</span>
                                <span class="fw-semibold">Debit & Credit Cards</span>
                            </div>
                            <span class="fw-bold fs-6">₹@(((decimal)ViewBag.CardTotal).ToString("0.00"))</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-trophy me-2 text-warning"></i>Top Selling Items Today</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Item</th>
                                    <th>Qty Sold</th>
                                    <th class="text-end">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in itemPopularity)
                                {
                                    <tr>
                                        <td class="fw-semibold">@item.ItemName</td>
                                        <td><span class="badge bg-dark">@item.Quantity</span></td>
                                        <td class="text-end fw-bold">₹@(((decimal)item.Revenue).ToString("0.00"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Visual Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Hourly Peak Rush Sales Trend -->
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-0"><i class="bi bi-graph-up-arrow me-2 text-success"></i>Hourly Sales Flow (Peak Rush Tracker)</h5>
                        <small class="text-muted">Today's transaction volume across operating hours (8 AM &ndash; 11 PM)</small>
                    </div>
                    <span class="badge bg-light text-dark border">Hourly Distribution</span>
                </div>
                <div style="height: 280px; position: relative;">
                    <canvas id="hourlySalesChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Payment Method Donut Chart -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 bg-white p-4">
                <div class="mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-pie-chart-fill me-2" style="color: var(--cafe-primary);"></i>Payment Split</h5>
                    <small class="text-muted">Ratio of UPI, Card, and Cash</small>
                </div>
                <div style="height: 280px; position: relative;" class="d-flex align-items-center justify-content-center">
                    <canvas id="paymentMethodChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const hourlyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.HourlyLabels));
        const hourlyValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.HourlyData));

        // Hourly Sales Flow Chart
        const hourlyCtx = document.getElementById('hourlySalesChart').getContext('2d');
        new Chart(hourlyCtx, {
            type: 'bar',
            data: {
                labels: hourlyLabels,
                datasets: [{
                    label: 'Sales (₹)',
                    data: hourlyValues,
                    backgroundColor: 'rgba(179, 104, 60, 0.75)',
                    borderColor: '#B3683C',
                    borderWidth: 2,
                    borderRadius: 6,
                    hoverBackgroundColor: '#8F4B23'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ` Revenue: ₹${context.parsed.y.toFixed(2)}`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return '₹' + value; }
                        },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Payment Method Donut Chart
        const paymentCtx = document.getElementById('paymentMethodChart').getContext('2d');
        const upiVal = @ViewBag.UpiTotal;
        const cashVal = @ViewBag.CashTotal;
        const cardVal = @ViewBag.CardTotal;
        const totalPayments = upiVal + cashVal + cardVal;

        new Chart(paymentCtx, {
            type: 'doughnut',
            data: {
                labels: ['UPI', 'Cash', 'Card'],
                datasets: [{
                    data: totalPayments === 0 ? [1, 1, 1] : [upiVal, cashVal, cardVal],
                    backgroundColor: ['#28a745', '#0d6efd', '#ffc107'],
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, font: { weight: 'bold' } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return ` ${context.label}: ₹${context.parsed.toFixed(2)}`;
                            }
                        }
                    }
                },
                cutout: '65%'
            }
        });
    </script>
}
