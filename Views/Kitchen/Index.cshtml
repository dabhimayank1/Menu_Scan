@model List<MenuScan.Models.Entities.Order>
@{
    ViewData["Title"] = "Kitchen Display System (KDS)";
    Layout = "_Layout";
    var restaurantId = (Guid)ViewBag.RestaurantId;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0 text-dark"><i class="bi bi-fire text-danger me-2"></i>Kitchen Display System</h3>
            <small class="text-muted">Real-time incoming table orders</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <!-- Soundbox Controls Pill -->
            <div class="d-flex align-items-center gap-1 bg-dark text-white rounded-pill px-3 py-1 shadow-sm">
                <button type="button" class="btn btn-link text-white p-0 text-decoration-none d-flex align-items-center" onclick="MenuScanSoundbox.toggle()" title="Toggle Voice Soundbox">
                    <i class="bi bi-volume-up-fill text-success fs-6 soundbox-status-icon"></i>
                    <span class="small ms-1 soundbox-status-text fw-bold" style="font-size: 0.8rem;">Soundbox: ON</span>
                </button>
                <span class="text-white-50 mx-1">|</span>
                <select class="form-select form-select-sm bg-dark text-white border-0 py-0 px-1 soundbox-lang-select" style="width: auto; font-size: 0.8rem; cursor: pointer;" onchange="MenuScanSoundbox.setLanguage(this.value)">
                    <option value="hi">🇮🇳 हिन्दी</option>
                    <option value="en">🇬🇧 English</option>
                </select>
                <button type="button" class="btn btn-outline-warning btn-sm rounded-pill py-0 px-2 text-warning border-0" style="font-size: 0.75rem;" onclick="MenuScanSoundbox.testSoundbox()" title="Test Soundbox Voice Output">
                    <i class="bi bi-play-fill"></i> Test
                </button>
            </div>
            <span id="kitchenConnectionStatusBadge" class="badge bg-success py-2 px-3 fs-6 d-flex align-items-center">
                <span class="spinner-grow spinner-grow-sm me-2" role="status"></span> Connected
            </span>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.location.reload()">
                <i class="bi bi-arrow-clockwise"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Live Waiter Calls Alert Container -->
    <div id="kitchenWaiterAlertContainer" class="mb-3"></div>

    <!-- KDS Filter Row -->
    <div class="d-flex gap-2 overflow-auto pb-2 mb-3 no-scrollbar" id="kdsFilterRow">
        <button class="btn btn-dark btn-sm rounded-pill px-3 active kds-filter" onclick="filterKds('all', this)">
            All Tickets (<span id="countAll">@Model.Count</span>)
        </button>
        <button class="btn btn-outline-danger btn-sm rounded-pill px-3 kds-filter" onclick="filterKds('New', this)">
            New (<span id="countNew">@Model.Count(o => o.Status == MenuScan.Models.Entities.OrderStatus.New)</span>)
        </button>
        <button class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3 kds-filter" onclick="filterKds('Preparing', this)">
            Preparing (<span id="countPrep">@Model.Count(o => o.Status == MenuScan.Models.Entities.OrderStatus.Preparing)</span>)
        </button>
        <button class="btn btn-outline-primary btn-sm rounded-pill px-3 kds-filter" onclick="filterKds('Ready', this)">
            Ready (<span id="countReady">@Model.Count(o => o.Status == MenuScan.Models.Entities.OrderStatus.Ready)</span>)
        </button>
        <button class="btn btn-outline-success btn-sm rounded-pill px-3 kds-filter" onclick="filterKds('Served', this)">
            Served (<span id="countServed">@Model.Count(o => o.Status == MenuScan.Models.Entities.OrderStatus.Served)</span>)
        </button>
    </div>

    <!-- KDS Ticket Grid -->
    <div class="row g-3" id="kdsTicketContainer">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5 text-muted" id="noOrdersMessage">
                <i class="bi bi-check-circle display-3 text-success"></i>
                <h4 class="mt-3">Kitchen is all caught up!</h4>
                <p>New orders will appear here automatically in real time.</p>
            </div>
        }

        @foreach (var order in Model)
        {
            <div class="col-12 col-md-6 col-lg-4 col-xl-3 kds-ticket-col" id="order-card-@order.Id" data-status="@order.Status" data-order-token="@order.OrderToken">
                <div class="card h-100 shadow-sm border-2 @(order.Status == MenuScan.Models.Entities.OrderStatus.New ? "border-danger" : "border-primary") rounded-3">
                    <div class="card-header @(order.Status == MenuScan.Models.Entities.OrderStatus.New ? "bg-danger text-white" : "bg-dark text-white") d-flex justify-content-between align-items-center py-2">
                        <span class="fw-bold fs-5">@order.Table?.TableNumber</span>
                        <span class="badge bg-light text-dark">#@order.OrderNumber.Substring(order.OrderNumber.Length - 4)</span>
                    </div>
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge sla-timer-badge bg-light text-dark border" data-created="@order.CreatedAtUtc.ToString("o")">
                                <i class="bi bi-clock me-1"></i>Calculating...
                            </span>
                            <span class="badge bg-secondary" id="badge-status-@order.Id">@order.Status</span>
                        </div>

                        @if (!string.IsNullOrEmpty(order.CustomerName))
                        {
                            <div class="small text-muted mb-1">
                                <i class="bi bi-person me-1"></i>@order.CustomerName
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(order.CustomerNotes))
                        {
                            <div class="alert alert-warning py-1 px-2 small mb-2">
                                <i class="bi bi-info-circle me-1"></i><strong>Note:</strong> @order.CustomerNotes
                            </div>
                        }

                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var item in order.OrderItems)
                            {
                                <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="fw-bold fs-6">@item.Quantity x</span> @item.ItemNameSnapshot
                                        @if (!string.IsNullOrEmpty(item.CustomizationSummary))
                                        {
                                            <div class="small text-muted">@item.CustomizationSummary</div>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>

                        <div class="mt-auto" id="actions-@order.Id">
                            @if (order.Status == MenuScan.Models.Entities.OrderStatus.New)
                            {
                                <button class="btn btn-warning w-100 fw-bold py-2 text-dark" onclick="updateOrderStatus('@order.Id', 2)">
                                    <i class="bi bi-fire me-1"></i> Accept & Prepare
                                </button>
                            }
                            else if (order.Status == MenuScan.Models.Entities.OrderStatus.Preparing)
                            {
                                <button class="btn btn-primary w-100 fw-bold py-2" onclick="updateOrderStatus('@order.Id', 3)">
                                    <i class="bi bi-bell me-1"></i> Mark as Ready
                                </button>
                            }
                            else if (order.Status == MenuScan.Models.Entities.OrderStatus.Ready)
                            {
                                <button class="btn btn-success w-100 fw-bold py-2 mb-2" onclick="updateOrderStatus('@order.Id', 4)">
                                    <i class="bi bi-check2-circle me-1"></i> Mark as Served
                                </button>
                                <button class="btn btn-outline-success btn-sm w-100 fw-semibold" onclick="sendKitchenWhatsApp('@order.OrderToken', '@(order.CustomerPhone ?? "")')">
                                    <i class="bi bi-whatsapp me-1"></i> WhatsApp Diner (Ready)
                                </button>
                            }
                            else if (order.Status == MenuScan.Models.Entities.OrderStatus.Served)
                            {
                                <div class="text-center text-success small fw-bold py-2">
                                    <i class="bi bi-check-all fs-5 me-1"></i> Food Served at Table
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/realtime.js" asp-append-version="true"></script>
    <script>
        const restaurantId = "@restaurantId";

        // Web Audio Chime synthesizer for instant zero-file sound alert
        function playChime() {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const now = ctx.currentTime;
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = "sine";
                osc.frequency.setValueAtTime(587.33, now); // D5
                osc.frequency.setValueAtTime(880.00, now + 0.15); // A5
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start(now);
                osc.stop(now + 0.5);
            } catch (e) {
                console.log("Audio alert blocked by browser autoplay policy until user interacts.");
            }
        }

        function updateConnectionStatusBadge(status) {
            const badge = document.getElementById('kitchenConnectionStatusBadge');
            if (!badge) return;
            if (status === 'Connected') {
                badge.className = 'badge bg-success py-2 px-3 fs-6 d-flex align-items-center';
                badge.innerHTML = '<span class="spinner-grow spinner-grow-sm me-2" role="status"></span> Connected';
            } else if (status === 'Reconnecting') {
                badge.className = 'badge bg-warning text-dark py-2 px-3 fs-6 d-flex align-items-center';
                badge.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Reconnecting';
            } else {
                badge.className = 'badge bg-danger text-white py-2 px-3 fs-6 d-flex align-items-center';
                badge.innerHTML = '<i class="bi bi-wifi-off me-2"></i> Offline';
            }
        }

        const hub = startHub({
            onJoin: async (conn) => {
                console.log("Joining Restaurant group:", restaurantId);
                await conn.invoke("JoinRestaurantGroup", restaurantId);
            },
            onStatus: updateConnectionStatusBadge,
            handlers: {
                ReceiveNewOrder: (order) => {
                    console.log("New order received in KDS:", order);

                    const noOrders = document.getElementById('noOrdersMessage');
                    if (noOrders) noOrders.remove();

                    const container = document.getElementById('kdsTicketContainer');
                    let itemsHtml = '';
                    (order.items || []).forEach(it => {
                        itemsHtml += `<li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                            <div><span class="fw-bold fs-6">${escapeHtml(it.qty)} x</span> ${escapeHtml(it.name)}${it.customizations ? `<div class="small text-muted">${escapeHtml(it.customizations)}</div>` : ''}</div>
                        </li>`;
                    });

                    const safeTable = escapeHtml(order.tableNumber);
                    const safeOrderNum = escapeHtml(order.orderNumber);
                    const safeNotes = escapeHtml(order.notes);
                    const safeCustomerName = escapeHtml(order.customerName);
                    const safeOrderToken = escapeHtml(order.orderToken || '');
                    const orderId = escapeHtml(order.orderId);

                    const cardHtml = `
                        <div class="col-12 col-md-6 col-lg-4 col-xl-3 kds-ticket-col animate__animated animate__fadeIn" id="order-card-${orderId}" data-status="New" data-order-token="${safeOrderToken}">
                            <div class="card h-100 shadow-sm border-2 border-danger rounded-3">
                                <div class="card-header bg-danger text-white d-flex justify-content-between align-items-center py-2">
                                    <span class="fw-bold fs-5">${safeTable}</span>
                                    <span class="badge bg-light text-dark">#${safeOrderNum.slice(-4)}</span>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between text-muted small mb-2">
                                        <span>Placed: ${escapeHtml(order.createdAt)}</span>
                                        <span class="badge bg-secondary" id="badge-status-${orderId}">New</span>
                                    </div>
                                    ${safeCustomerName ? `<div class="small text-muted mb-1"><i class="bi bi-person me-1"></i>${safeCustomerName}</div>` : ''}
                                    ${safeNotes ? `<div class="alert alert-warning py-1 px-2 small mb-2"><strong>Note:</strong> ${safeNotes}</div>` : ''}
                                    <ul class="list-group list-group-flush mb-3">${itemsHtml}</ul>
                                    <div class="mt-auto" id="actions-${orderId}">
                                        <button class="btn btn-warning w-100 fw-bold py-2 text-dark" onclick="updateOrderStatus('${orderId}', 2)">
                                            <i class="bi bi-fire me-1"></i> Accept & Prepare
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                    container.insertAdjacentHTML('afterbegin', cardHtml);
                    updateSlaBadges();
                    applyCurrentFilter();
                    refreshFilterCounts();
                    MenuScanSoundbox.announceNewOrder(order.tableNumber, order.totalAmount, order.itemCount);
                },

                ReceiveWaiterCall: (data) => {
                    console.log("Waiter call received in KDS:", data);
                    MenuScanSoundbox.announceServiceCall(data.tableNumber, data.requestType);

                    const alertContainer = document.getElementById('kitchenWaiterAlertContainer');
                    const alertId = `waiter-call-${Date.now()}`;
                    const safeTable = escapeHtml(data.tableNumber);
                    const safeType = escapeHtml(data.requestType);
                    const safeNotes = escapeHtml(data.notes);
                    const safeCreated = escapeHtml(data.createdAt);

                    const alertHtml = `
                        <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center justify-content-between p-3" id="${alertId}">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fs-3">🛎️</span>
                                <div>
                                    <span class="badge bg-dark fs-6">${safeTable}</span>
                                    <strong class="ms-2">Request: ${safeType}</strong>
                                    ${safeNotes ? `<span class="text-muted small ms-2">(${safeNotes})</span>` : ''}
                                    <div class="text-muted small mt-1"><i class="bi bi-clock me-1"></i>${safeCreated}</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill px-3" onclick="document.getElementById('${alertId}').remove()">
                                <i class="bi bi-check-lg me-1"></i> Acknowledge
                            </button>
                        </div>
                    `;
                    alertContainer.insertAdjacentHTML('afterbegin', alertHtml);
                },

                ReceiveOrderStatusUpdate: (orderNumber, newStatus, tableNumber, orderId) => {
                    console.log("Order status update:", orderNumber, newStatus, tableNumber, orderId);
                    let card = null;
                    if (orderId) {
                        card = document.getElementById(`order-card-${orderId}`);
                    }
                    if (!card && orderNumber) {
                        const targetShort = '#' + String(orderNumber).slice(-4);
                        document.querySelectorAll('.kds-ticket-col').forEach(c => {
                            if (c.innerText.includes(targetShort)) {
                                card = c;
                            }
                        });
                    }

                    if (newStatus === "Completed" || newStatus === "Cancelled") {
                        if (card) {
                            card.remove();
                        }
                        const remaining = document.querySelectorAll('.kds-ticket-col');
                        if (remaining.length === 0) {
                            const container = document.getElementById('kdsTicketContainer');
                            if (container && !document.getElementById('noOrdersMessage')) {
                                container.innerHTML = `
                                    <div class="col-12 text-center py-5 text-muted" id="noOrdersMessage">
                                        <i class="bi bi-check-circle display-3 text-success"></i>
                                        <h4 class="mt-3">Kitchen is all caught up!</h4>
                                        <p>New orders will appear here automatically in real time.</p>
                                    </div>`;
                            }
                        }
                    } else if (card) {
                        const id = orderId || card.id.replace('order-card-', '');
                        const badge = document.getElementById(`badge-status-${id}`);
                        const actions = document.getElementById(`actions-${id}`);

                        if (newStatus === "Preparing") {
                            if (badge) badge.innerText = "Preparing";
                            card.setAttribute('data-status', 'Preparing');
                            if (actions) {
                                actions.innerHTML = `
                                    <button class="btn btn-primary w-100 fw-bold py-2" onclick="updateOrderStatus('${id}', 3)">
                                        <i class="bi bi-bell me-1"></i> Mark as Ready
                                    </button>`;
                            }
                        } else if (newStatus === "Ready") {
                            if (badge) badge.innerText = "Ready";
                            card.setAttribute('data-status', 'Ready');
                            if (actions) {
                                actions.innerHTML = `
                                    <button class="btn btn-success w-100 fw-bold py-2 mb-2" onclick="updateOrderStatus('${id}', 4)">
                                        <i class="bi bi-check2-circle me-1"></i> Mark as Served
                                    </button>
                                    <button class="btn btn-outline-success btn-sm w-100 fw-semibold" onclick="sendKitchenWhatsApp('${id}')">
                                        <i class="bi bi-whatsapp me-1"></i> WhatsApp Diner (Ready)
                                    </button>`;
                            }
                        } else if (newStatus === "Served") {
                            if (badge) badge.innerText = "Served";
                            card.setAttribute('data-status', 'Served');
                            if (actions) {
                                actions.innerHTML = `
                                    <div class="text-center text-success small fw-bold py-2">
                                        <i class="bi bi-check-all fs-5 me-1"></i> Food Served at Table
                                    </div>`;
                            }
                        }
                    }
                    applyCurrentFilter();
                    refreshFilterCounts();
                }
            }
        });

        async function updateOrderStatus(orderId, newStatus) {
            try {
                const response = await fetch('/Kitchen/UpdateStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify({ orderId: orderId, newStatus: newStatus })
                });

                if (response.ok) {
                    const card = document.getElementById(`order-card-${orderId}`);
                    const badge = document.getElementById(`badge-status-${orderId}`);
                    const actions = document.getElementById(`actions-${orderId}`);
                    
                    if (newStatus === 2) { // Preparing
                        if (badge) badge.innerText = "Preparing";
                        if (card) card.setAttribute('data-status', 'Preparing');
                        if (actions) {
                            actions.innerHTML = `
                                <button class="btn btn-primary w-100 fw-bold py-2" onclick="updateOrderStatus('${orderId}', 3)">
                                    <i class="bi bi-bell me-1"></i> Mark as Ready
                                </button>`;
                        }
                    } else if (newStatus === 3) { // Ready
                        if (badge) badge.innerText = "Ready";
                        if (card) card.setAttribute('data-status', 'Ready');
                        if (actions) {
                            actions.innerHTML = `
                                <button class="btn btn-success w-100 fw-bold py-2 mb-2" onclick="updateOrderStatus('${orderId}', 4)">
                                    <i class="bi bi-check2-circle me-1"></i> Mark as Served
                                </button>
                                <button class="btn btn-outline-success btn-sm w-100 fw-semibold" onclick="sendKitchenWhatsApp('${orderId}')">
                                    <i class="bi bi-whatsapp me-1"></i> WhatsApp Diner (Ready)
                                </button>`;
                        }
                    } else if (newStatus === 4) { // Served
                        if (badge) badge.innerText = "Served";
                        if (card) card.setAttribute('data-status', 'Served');
                        if (actions) {
                            actions.innerHTML = `
                                <div class="text-center text-success small fw-bold py-2">
                                    <i class="bi bi-check-all fs-5 me-1"></i> Food Served at Table
                                </div>`;
                        }
                    }
                    applyCurrentFilter();
                    refreshFilterCounts();
                } else {
                    alert("Failed to update status.");
                }
            } catch (err) {
                console.error(err);
                alert("Error updating status.");
            }
        }

        function updateSlaBadges() {
            const now = new Date();
            document.querySelectorAll('.sla-timer-badge').forEach(badge => {
                const createdStr = badge.getAttribute('data-created');
                if (!createdStr) return;
                const created = new Date(createdStr);
                const diffMin = Math.max(0, Math.floor((now - created) / 60000));

                if (diffMin < 10) {
                    badge.className = "badge sla-timer-badge bg-success-subtle text-success border border-success-subtle";
                    badge.innerHTML = `<i class="bi bi-clock me-1"></i>${diffMin}m (Normal)`;
                } else if (diffMin < 20) {
                    badge.className = "badge sla-timer-badge bg-warning-subtle text-dark border border-warning";
                    badge.innerHTML = `<i class="bi bi-exclamation-triangle me-1"></i>${diffMin}m (Attn)`;
                } else {
                    badge.className = "badge sla-timer-badge bg-danger text-white";
                    badge.innerHTML = `<i class="bi bi-fire me-1"></i>${diffMin}m (DELAYED)`;
                }
            });
        }
        setInterval(updateSlaBadges, 10000);
        updateSlaBadges();

        let currentKdsFilter = 'all';
        function applyCurrentFilter() {
            document.querySelectorAll('.kds-ticket-col').forEach(card => {
                const cardStatus = card.getAttribute('data-status');
                if (currentKdsFilter === 'all' || cardStatus === currentKdsFilter) {
                    card.classList.remove('d-none');
                } else {
                    card.classList.add('d-none');
                }
            });
        }

        function filterKds(status, btn) {
            currentKdsFilter = status;
            document.querySelectorAll('.kds-filter').forEach(b => {
                b.classList.remove('active', 'btn-dark');
                if (!b.classList.contains('btn-outline-danger') && !b.classList.contains('btn-outline-warning') && !b.classList.contains('btn-outline-primary') && !b.classList.contains('btn-outline-success')) {
                    b.classList.add('btn-outline-dark');
                }
            });
            btn.classList.add('active', 'btn-dark');
            applyCurrentFilter();
        }

        function refreshFilterCounts() {
            const cards = document.querySelectorAll('.kds-ticket-col');
            let countNew = 0, countPrep = 0, countReady = 0, countServed = 0;
            cards.forEach(c => {
                const s = c.getAttribute('data-status');
                if (s === 'New') countNew++;
                else if (s === 'Preparing') countPrep++;
                else if (s === 'Ready') countReady++;
                else if (s === 'Served') countServed++;
            });
            document.getElementById('countAll').innerText = cards.length;
            document.getElementById('countNew').innerText = countNew;
            document.getElementById('countPrep').innerText = countPrep;
            document.getElementById('countReady').innerText = countReady;
            document.getElementById('countServed').innerText = countServed;
        }

        async function sendKitchenWhatsApp(orderTokenOrId, phone = "") {
            let token = orderTokenOrId;
            const card = document.getElementById(`order-card-${orderTokenOrId}`);
            if (card && card.dataset.orderToken) {
                token = card.dataset.orderToken;
            }
            try {
                const res = await fetch(`/api/order/whatsapp-link?orderToken=${encodeURIComponent(token)}&type=ready&phone=${encodeURIComponent(phone)}`);
                const data = await res.json();
                if (res.ok && data.url) {
                    window.open(data.url, '_blank');
                } else {
                    alert(data.message || "Failed to generate WhatsApp link.");
                }
            } catch (e) {
                console.error(e);
                alert("Network error.");
            }
        }
    </script>
}
