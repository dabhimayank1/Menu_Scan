@model MenuScan.Models.ViewModels.OrderTrackingViewModel
@{
    ViewData["Title"] = $"Track Order #{Model.Order.OrderNumber}";
    Layout = "_Layout";
    var statusInt = (int)Model.Order.Status;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Header Card -->
            <div class="card shadow border-0 rounded-4 mb-4 text-center overflow-hidden">
                <div class="cafe-promo-banner rounded-0 text-white py-4 px-3">
                    <span class="badge bg-warning text-dark mb-2 px-3 py-1 rounded-pill fw-bold">☕ @Model.Restaurant.Name</span>
                    <h3 class="fw-bold mb-1 text-white">Order #@Model.Order.OrderNumber</h3>
                    <p class="text-white-50 mb-0 small"><i class="bi bi-geo-alt"></i> @Model.Table.TableNumber | Placed at @Model.Order.CreatedAtUtc.ToLocalTime().ToString("hh:mm tt")</p>
                </div>

                <div class="card-body p-4 bg-white">
                    <h5 class="fw-bold mb-3">Live Order Tracking</h5>
                    
                    <!-- Progress Timeline -->
                    <div class="position-relative m-4">
                        <div class="progress" style="height: 6px; background-color: var(--cafe-border);">
                            @{
                                var pct = statusInt switch
                                {
                                    0 => 10,
                                    1 => 35,
                                    2 => 65,
                                    3 => 90,
                                    4 or 6 => 100,
                                    _ => 0
                                };
                            }
                            <div id="statusProgressBar" class="progress-bar" role="progressbar" 
                                 style="width: @pct%; background-color: var(--cafe-primary);" 
                                 aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="d-flex justify-content-between position-absolute top-0 start-0 w-100 translate-middle-y">
                            <span class="badge rounded-pill @(statusInt >= 0 ? "bg-dark text-white" : "bg-light text-muted border") p-2" id="step-0" title="Placed">
                                <i class="bi bi-check-lg"></i>
                            </span>
                            <span class="badge rounded-pill @(statusInt >= 1 ? "bg-dark text-white" : "bg-light text-muted border") p-2" id="step-1" title="Accepted">
                                <i class="bi bi-person-check"></i>
                            </span>
                            <span class="badge rounded-pill @(statusInt >= 2 ? "bg-dark text-white" : "bg-light text-muted border") p-2" id="step-2" title="Preparing">
                                <i class="bi bi-fire"></i>
                            </span>
                            <span class="badge rounded-pill @(statusInt >= 3 ? "bg-dark text-white" : "bg-light text-muted border") p-2" id="step-3" title="Ready">
                                <i class="bi bi-bell"></i>
                            </span>
                            <span class="badge rounded-pill @(statusInt >= 4 ? "bg-dark text-white" : "bg-light text-muted border") p-2" id="step-4" title="Served">
                                <i class="bi bi-cup-hot"></i>
                            </span>
                        </div>
                    </div>

                    <div class="mt-4 p-3 rounded-4 text-center" style="background-color: var(--cafe-primary-light);" id="statusMessageAlert">
                        <h5 class="fw-bold mb-1" style="color: var(--cafe-primary);" id="currentStatusText">@Model.Order.Status</h5>
                        <p class="text-muted small mb-0" id="currentStatusDesc">
                            @switch (Model.Order.Status)
                            {
                                case MenuScan.Models.Entities.OrderStatus.New:
                                    @:Order received by the kitchen. Waiting for barista/chef to accept.
                                    break;
                                case MenuScan.Models.Entities.OrderStatus.Accepted:
                                    @:The kitchen has accepted your order!
                                    break;
                                case MenuScan.Models.Entities.OrderStatus.Preparing:
                                    @:Our chef & barista are brewing and preparing your order fresh!
                                    break;
                                case MenuScan.Models.Entities.OrderStatus.Ready:
                                    @:Your order is ready! A server will bring it to your table shortly.
                                    break;
                                case MenuScan.Models.Entities.OrderStatus.Served:
                                    @:Bon Appetit! Your food & drinks have been served.
                                    break;
                                case MenuScan.Models.Entities.OrderStatus.Completed:
                                    @:Bill settled. Thank you for dining at @Model.Restaurant.Name!
                                    break;
                                default:
                                    @:Order status updated.
                                    break;
                            }
                        </p>
                    </div>
                </div>
            </div>

            <!-- Order Summary Card -->
            <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-receipt me-2 text-primary"></i>Ordered Items</h6>
                </div>
                <div class="card-body p-3">
                    @foreach (var item in Model.Order.OrderItems)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <div>
                                <span class="fw-semibold">@item.Quantity x @item.ItemNameSnapshot</span>
                                @if (!string.IsNullOrEmpty(item.CustomizationSummary))
                                {
                                    <div class="small text-muted">@item.CustomizationSummary</div>
                                }
                            </div>
                            <span class="fw-bold text-dark">₹@item.TotalPrice.ToString("0.00")</span>
                        </div>
                    }

                    <div class="pt-3">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Subtotal</span>
                            <span>₹@Model.Order.SubTotal.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Taxes (@Model.Order.TaxRate%)</span>
                            <span>₹@Model.Order.TaxAmount.ToString("0.00")</span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-2">
                            <span>Total</span>
                            <span style="color: var(--cafe-primary);">₹@Model.Order.TotalAmount.ToString("0.00")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bill Settlement & Online Payment Card -->
            @{
                var isOrderPaid = Model.Order.Status == MenuScan.Models.Entities.OrderStatus.Completed || 
                                  (Model.Order.Bill != null && Model.Order.Bill.Status == MenuScan.Models.Entities.BillStatus.Paid);
            }
            <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white overflow-hidden" id="onlinePaymentCard">
                <div class="card-header text-white py-3 d-flex justify-content-between align-items-center" style="background-color: #241812;">
                    <h6 class="fw-bold mb-0 text-white"><i class="bi bi-wallet2 text-success me-2"></i>Table Bill &amp; Payment</h6>
                    <span class="badge @(isOrderPaid ? "bg-success" : "bg-warning text-dark") rounded-pill px-3 py-1" id="badgePaymentStatus">
                        @(isOrderPaid ? "✓ Paid & Settled" : "Unpaid")
                    </span>
                </div>
                
                <div class="card-body p-4 text-center">
                    <div id="paymentUnpaidSection" class="@(isOrderPaid ? "d-none" : "")">
                        <span class="badge bg-light text-muted border px-3 py-1 rounded-pill small mb-2">Self-Checkout</span>
                        <h3 class="fw-bold mb-1" style="color: var(--cafe-primary);">₹@Model.Order.TotalAmount.ToString("0.00")</h3>
                        <p class="text-muted small mb-3">Pay securely at your table using Google Pay, PhonePe, Paytm, or any UPI app</p>
                        
                        <button type="button" class="btn btn-success w-100 rounded-pill py-3 fw-bold shadow-sm" onclick="openUpiCheckoutModal()">
                            <i class="bi bi-qr-code-scan me-2"></i> Scan &amp; Pay via UPI
                        </button>
                    </div>

                    <div id="paymentPaidSection" class="@(isOrderPaid ? "" : "d-none")">
                        <span class="display-4 text-success d-block mb-2">✅</span>
                        <h5 class="fw-bold mb-1 text-success">Bill Settled &amp; Paid</h5>
                        <p class="text-muted small mb-3">
                            Bill Ref: <strong id="paidBillNumberText">@(Model.Order.Bill?.BillNumber ?? "BILL-PAID")</strong> • Paid via UPI
                        </p>
                        <button type="button" class="btn btn-outline-dark rounded-pill px-4 btn-sm" onclick="openReceiptModal()">
                            <i class="bi bi-receipt me-1"></i> View Tax Receipt
                        </button>
                    </div>

                    <div id="paymentSuccessAlert" class="alert alert-success d-none rounded-3 py-2 px-3 small mt-3">
                        <i class="bi bi-check-circle-fill me-1"></i> Payment confirmed! Click <strong>View Tax Receipt</strong> above to inspect or print your official bill.
                    </div>
                </div>
            </div>

            <!-- Customer Rating & Feedback Card -->
            <div class="card shadow-sm border-0 rounded-4 mb-4 bg-white overflow-hidden @(statusInt < 4 && !Model.HasSubmittedFeedback ? "d-none" : "")" id="customerFeedbackCard">
                <div class="card-header text-white py-3 d-flex justify-content-between align-items-center" style="background-color: #241812;">
                    <h6 class="fw-bold mb-0 text-white"><i class="bi bi-star-fill text-warning me-2"></i>Rate Your Experience</h6>
                    <span class="badge bg-warning text-dark rounded-pill px-2 py-1 small">Feedback</span>
                </div>
                
                @if (Model.HasSubmittedFeedback)
                {
                    <div class="card-body p-4 text-center">
                        <span class="display-4 text-success d-block mb-2">🎉</span>
                        <h5 class="fw-bold mb-1">Feedback Submitted!</h5>
                        <p class="text-muted small mb-0">Thank you for helping us improve our dining service. We look forward to serving you again!</p>
                    </div>
                }
                else
                {
                    <div class="card-body p-4 text-center" id="feedbackFormContainer">
                        <p class="text-muted small mb-3">How was your dining experience at <strong>@Model.Restaurant.Name</strong>?</p>
                        
                        <!-- Overall Rating -->
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase text-muted d-block">Overall Experience</label>
                            <div class="d-flex justify-content-center gap-2 fs-2 my-1" id="starGroupOverall">
                                <i class="bi bi-star-fill text-warning star-icon" data-val="1" onclick="setRating('Overall', 1)" style="cursor: pointer;"></i>
                                <i class="bi bi-star-fill text-warning star-icon" data-val="2" onclick="setRating('Overall', 2)" style="cursor: pointer;"></i>
                                <i class="bi bi-star-fill text-warning star-icon" data-val="3" onclick="setRating('Overall', 3)" style="cursor: pointer;"></i>
                                <i class="bi bi-star-fill text-warning star-icon" data-val="4" onclick="setRating('Overall', 4)" style="cursor: pointer;"></i>
                                <i class="bi bi-star-fill text-warning star-icon" data-val="5" onclick="setRating('Overall', 5)" style="cursor: pointer;"></i>
                            </div>
                            <span class="badge bg-light text-dark border rounded-pill px-3 py-1 small fw-semibold" id="labelOverall">5 - Outstanding ⭐</span>
                        </div>

                        <!-- Mini breakdown for Food & Service -->
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <div class="bg-light p-2 rounded-3 text-center border">
                                    <small class="fw-bold d-block mb-1 text-muted">Food &amp; Drinks</small>
                                    <div class="d-flex justify-content-center gap-1 fs-5" id="starGroupFood">
                                        <i class="bi bi-star-fill text-warning" data-val="1" onclick="setRating('Food', 1)" style="cursor: pointer;"></i>
                                        <i class="bi bi-star-fill text-warning" data-val="2" onclick="setRating('Food', 2)" style="cursor: pointer;"></i>
                                        <i class="bi bi-star-fill text-warning" data-val="3" onclick="setRating('Food', 3)" style="cursor: pointer;"></i>
                                        <i class="bi bi-star-fill text-warning" data-val="4" onclick="setRating('Food', 4)" style="cursor: pointer;"></i>
                                        <i class="bi bi-star-fill text-warning" data-val="5" onclick="setRating('Food', 5)" style="cursor: pointer;"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="bg-light p-2 rounded-3 text-center border">
                                    <small class="fw-bold d-block mb-1 text-muted">Service &amp; Speed</small>
                                    <div class="d-flex justify-content-center gap-1 fs-5" id="starGroupService">
                                        <i class="bi bi-star-fill text-warning" data-val="1" onclick="setRating('Service', 1)" style="cursor: pointer;"></i>
                                        <i class="bi bi-star-fill text-warning" data-val="2" onclick="setRating('Service', 2)" style="cursor: pointer;"></i>
                                        <i class="bi bi-star-fill text-warning" data-val="3" onclick="setRating('Service', 3)" style="cursor: pointer;"></i>
                                        <i class="bi bi-star-fill text-warning" data-val="4" onclick="setRating('Service', 4)" style="cursor: pointer;"></i>
                                        <i class="bi bi-star-fill text-warning" data-val="5" onclick="setRating('Service', 5)" style="cursor: pointer;"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tag Pills -->
                        <div class="mb-3 text-start">
                            <label class="form-label small fw-bold text-uppercase text-muted d-block text-center">What stood out?</label>
                            <div class="d-flex flex-wrap justify-content-center gap-2" id="feedbackTagsContainer">
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill tag-pill" onclick="toggleFeedbackTag(this, '☕ Great Coffee')">☕ Great Coffee</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill tag-pill" onclick="toggleFeedbackTag(this, '🍕 Delicious Food')">🍕 Delicious Food</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill tag-pill" onclick="toggleFeedbackTag(this, '⚡ Fast Service')">⚡ Fast Service</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill tag-pill" onclick="toggleFeedbackTag(this, '🎶 Good Ambience')">🎶 Good Ambience</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill tag-pill" onclick="toggleFeedbackTag(this, '💰 Value for Money')">💰 Value for Money</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill tag-pill" onclick="toggleFeedbackTag(this, '🧹 Clean & Sanitized')">🧹 Clean Table</button>
                            </div>
                        </div>

                        <!-- Optional Name & Textarea -->
                        <div class="mb-3 text-start">
                            <input type="text" id="feedbackCustomerName" class="form-control form-control-sm rounded-3 mb-2" placeholder="Your Name (Optional)" />
                            <textarea id="feedbackComment" class="form-control form-control-sm rounded-3" rows="2" placeholder="Any suggestions or compliments? (Optional)"></textarea>
                        </div>

                        <button type="button" class="btn btn-cafe-primary w-100 rounded-pill py-2 fw-bold" id="btnSubmitFeedback" onclick="submitCustomerFeedback()">
                            <i class="bi bi-send-fill me-1"></i> Submit Review
                        </button>
                    </div>

                    <div class="card-body p-4 text-center d-none" id="feedbackSuccessContainer">
                        <span class="display-4 text-success d-block mb-2">🎉</span>
                        <h5 class="fw-bold mb-1">Thank You So Much!</h5>
                        <p class="text-muted small mb-0">Your feedback has been received by our management team. We look forward to seeing you again!</p>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-center gap-2 mb-4">
                <a href="/r/@Model.Restaurant.Slug/t/@Model.Table.Token" class="btn btn-cafe-outline rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Add More Items
                </a>
                <button type="button" class="btn btn-outline-warning text-dark rounded-pill px-4 fw-semibold" onclick="openTrackWaiterModal()">
                    <i class="bi bi-bell-fill text-warning me-1"></i> Call Waiter / Bill
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Call Waiter Modal in Tracking -->
<div class="modal fade" id="trackWaiterModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-bell-fill text-warning me-2"></i>Table Assistance &amp; Bill
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">Table <strong>@Model.Table.TableNumber</strong> (Order #@Model.Order.OrderNumber)</p>
                <div class="d-grid gap-2 mb-3">
                    <button type="button" class="btn btn-outline-dark py-2 text-start d-flex align-items-center gap-2 track-opt active" onclick="setTrackServiceType('Assistance', this)">
                        <span class="fs-4">🛎️</span>
                        <div>
                            <div class="fw-bold small">Call Server to Table</div>
                            <small class="text-muted">General service or inquiry</small>
                        </div>
                    </button>
                    <button type="button" class="btn btn-outline-dark py-2 text-start d-flex align-items-center gap-2 track-opt" onclick="setTrackServiceType('Water', this)">
                        <span class="fs-4">💧</span>
                        <div>
                            <div class="fw-bold small">Drinking Water</div>
                            <small class="text-muted">Glass refills</small>
                        </div>
                    </button>
                    <button type="button" class="btn btn-outline-dark py-2 text-start d-flex align-items-center gap-2 track-opt" onclick="setTrackServiceType('Bill', this)">
                        <span class="fs-4">💳</span>
                        <div>
                            <div class="fw-bold small">Request Final Bill</div>
                            <small class="text-muted">Prepare check for payment</small>
                        </div>
                    </button>
                </div>
                <div id="trackCallAlert" class="alert alert-success d-none rounded-3 py-2 px-3 small">
                    <i class="bi bi-check-circle me-1"></i> Waiter notified! A server will attend to your table shortly.
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-cafe-primary rounded-pill px-4" id="btnSendTrackService" onclick="sendTrackServiceCall()">
                    <i class="bi bi-send me-1"></i> Request Now
                </button>
            </div>
        </div>
    </div>
</div>

<!-- UPI Self-Checkout Modal -->
<div class="modal fade" id="upiCheckoutModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header text-white p-3" style="background-color: #241812;">
                <div>
                    <h5 class="modal-title fw-bold"><i class="bi bi-qr-code-scan text-success me-2"></i>UPI QR &amp; Mobile Payment</h5>
                    <small class="text-white-50">@Model.Restaurant.Name • Table @Model.Table.TableNumber</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <div class="spinner-border text-primary my-4" role="status" id="upiLoadingSpinner"></div>
                
                <div id="upiModalContent" class="d-none">
                    <!-- Dynamic UPI QR Scanner Box -->
                    <div class="position-relative d-inline-block p-3 bg-white rounded-4 border shadow-sm mb-3" style="max-width: 260px;">
                        <img id="upiQrImage" src="" alt="Scan to Pay via UPI" class="img-fluid rounded-3" style="width: 210px; height: 210px; object-fit: contain; transition: opacity 0.2s;" />
                        <div class="small fw-semibold text-muted mt-2 d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-camera text-primary"></i> Scan with GPay, PhonePe, Paytm or BHIM
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <span class="text-muted small d-block">Grand Total to Pay</span>
                        <h3 class="fw-bold my-1" style="color: var(--cafe-primary);">₹<span id="upiAmountText">@Model.Order.TotalAmount.ToString("0.00")</span></h3>
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1 small">
                            <i class="bi bi-shield-check text-success me-1"></i>Verified Merchant UPI Self-Checkout
                        </span>
                    </div>

                    <!-- UPI Handle Switcher -->
                    <div class="mb-3 text-start">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label small fw-bold text-uppercase text-muted mb-0">Select UPI Handle</label>
                            <small class="text-muted">Updates QR instantly</small>
                        </div>
                        <div class="d-flex flex-wrap justify-content-center gap-1" id="upiHandlePills">
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 upi-handle-btn" data-handle="upi" onclick="switchUpiHandle('upi', this)">
                                @@upi (BHIM)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 upi-handle-btn" data-handle="ybl" onclick="switchUpiHandle('ybl', this)">
                                @@ybl (PhonePe)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 upi-handle-btn" data-handle="okaxis" onclick="switchUpiHandle('okaxis', this)">
                                @@okaxis (GPay)
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 upi-handle-btn" data-handle="paytm" onclick="switchUpiHandle('paytm', this)">
                                @@paytm (Paytm)
                            </button>
                        </div>
                    </div>

                    <!-- 1-Tap Mobile Intent Buttons -->
                    <div class="mb-3">
                        <div class="small fw-bold text-muted mb-2 text-uppercase text-start">1-Tap Direct UPI App Pay</div>
                        <div class="row g-2">
                            <div class="col-6">
                                <a id="btnDirectGPay" href="#" class="btn btn-outline-dark w-100 rounded-pill py-2 small fw-bold d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-google text-primary"></i> GPay
                                </a>
                            </div>
                            <div class="col-6">
                                <a id="btnDirectPhonePe" href="#" class="btn btn-outline-dark w-100 rounded-pill py-2 small fw-bold d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-phone-fill" style="color: #5f259f;"></i> PhonePe
                                </a>
                            </div>
                            <div class="col-6">
                                <a id="btnDirectPaytm" href="#" class="btn btn-outline-dark w-100 rounded-pill py-2 small fw-bold d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-wallet-fill text-info"></i> Paytm
                                </a>
                            </div>
                            <div class="col-6">
                                <a id="btnDirectUpiIntent" href="#" class="btn btn-primary w-100 rounded-pill py-2 small fw-bold d-flex align-items-center justify-content-center gap-1">
                                    <i class="bi bi-lightning-charge-fill"></i> Any UPI
                                </a>
                            </div>
                        </div>
                    </div>

                    <hr class="my-3 text-muted" />

                    <!-- Payment Completion Step -->
                    <div class="bg-light p-3 rounded-4 border text-start">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="small text-dark"><i class="bi bi-check2-circle text-success me-1"></i>Completed Payment?</strong>
                            <span class="badge bg-light text-muted border small">Step 2</span>
                        </div>
                        <small class="text-muted d-block mb-2">After scanning and paying via Google Pay, PhonePe, or Paytm, enter your UPI Reference (UTR) number to confirm:</small>
                        <div class="mb-2">
                            <input type="text" id="upiUtrNumberInput" class="form-control form-control-sm rounded-3 font-monospace text-center" placeholder="12-digit UPI UTR / Ref (Optional)" maxlength="16" />
                        </div>
                        <button type="button" class="btn btn-success w-100 rounded-pill py-2 fw-bold" id="btnSimulateUpiPay" onclick="simulateUpiPayment()">
                            <i class="bi bi-check-circle-fill me-1"></i> I Have Paid via UPI
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Digital Tax Receipt Modal -->
<div class="modal fade" id="receiptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-body p-4 bg-white" id="receiptPrintArea">
                <div class="text-center mb-3">
                    <span class="fs-3">☕</span>
                    <h5 class="fw-bold mb-0">@Model.Restaurant.Name</h5>
                    <small class="text-muted d-block">GST/Tax ID: @(Model.Restaurant.TaxNumber ?? "GSTIN-27AABCS1429B1Z")</small>
                    <small class="text-muted d-block">Official Dine-in Tax Receipt</small>
                </div>
                <div class="border-top border-bottom py-2 my-2 small">
                    <div class="d-flex justify-content-between">
                        <span>Receipt: <strong id="receiptBillNum">@(Model.Order.Bill?.BillNumber ?? "BILL-PAID")</strong></span>
                        <span>Date: <strong>@DateTime.UtcNow.ToLocalTime().ToString("dd MMM yyyy")</strong></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span>Table: <strong>@Model.Table.TableNumber</strong></span>
                        <span>Order: <strong>#@Model.Order.OrderNumber</strong></span>
                    </div>
                </div>

                <div class="mb-3">
                    @foreach (var it in Model.Order.OrderItems)
                    {
                        <div class="d-flex justify-content-between small py-1">
                            <span>@it.Quantity x @it.ItemNameSnapshot</span>
                            <span>₹@it.TotalPrice.ToString("0.00")</span>
                        </div>
                    }
                </div>

                <div class="border-top pt-2 small">
                    <div class="d-flex justify-content-between text-muted">
                        <span>Subtotal:</span>
                        <span>₹@Model.Order.SubTotal.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted">
                        <span>CGST + SGST (@Model.Order.TaxRate%):</span>
                        <span>₹@Model.Order.TaxAmount.ToString("0.00")</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5 border-top mt-2 pt-2 text-dark">
                        <span>Grand Total:</span>
                        <span style="color: var(--cafe-primary);">₹@Model.Order.TotalAmount.ToString("0.00")</span>
                    </div>
                    <div class="badge bg-success text-white w-100 py-2 mt-3 fs-6 rounded-pill">
                        PAID &amp; SETTLED VIA UPI
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print / Save PDF
                </button>
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const orderToken = "@Model.Order.OrderToken";
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/order")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveOrderStatusUpdate", (orderNumber, newStatus, tableNumber) => {
            console.log("Status update received:", orderNumber, newStatus);
            document.getElementById('currentStatusText').innerText = newStatus;
            
            let pct = 20;
            if (newStatus === "Accepted") pct = 35;
            else if (newStatus === "Preparing") pct = 65;
            else if (newStatus === "Ready") pct = 90;
            if (newStatus === "Served" || newStatus === "Completed") {
                pct = 100;
                const feedbackCard = document.getElementById('customerFeedbackCard');
                if (feedbackCard) feedbackCard.classList.remove('d-none');
            }

            if (newStatus === "Completed") {
                const unpaidSec = document.getElementById('paymentUnpaidSection');
                const paidSec = document.getElementById('paymentPaidSection');
                const badge = document.getElementById('badgePaymentStatus');
                if (unpaidSec) unpaidSec.classList.add('d-none');
                if (paidSec) paidSec.classList.remove('d-none');
                if (badge) {
                    badge.className = "badge bg-success rounded-pill px-3 py-1";
                    badge.innerText = "✓ Paid & Settled";
                }
            }

            document.getElementById('statusProgressBar').style.width = pct + "%";
            document.getElementById('currentStatusDesc').innerText = `Your order status changed to ${newStatus}.`;
        });

        connection.start().then(() => {
            connection.invoke("JoinOrderGroup", orderToken);
        }).catch(err => console.error("SignalR connection error:", err));

        let feedbackRatings = {
            Overall: 5,
            Food: 5,
            Service: 5
        };
        const selectedFeedbackTags = new Set();

        const ratingLabels = {
            5: "5 - Outstanding ⭐",
            4: "4 - Very Good 👍",
            3: "3 - Average 👌",
            2: "2 - Needs Work ⚠️",
            1: "1 - Poor Experience ❌"
        };

        function setRating(category, val) {
            feedbackRatings[category] = val;
            const group = document.getElementById(`starGroup${category}`);
            if (group) {
                const stars = group.querySelectorAll('i');
                stars.forEach((s, idx) => {
                    if (idx < val) {
                        s.className = "bi bi-star-fill text-warning";
                    } else {
                        s.className = "bi bi-star text-muted";
                    }
                });
            }

            if (category === 'Overall') {
                const lbl = document.getElementById('labelOverall');
                if (lbl) lbl.innerText = ratingLabels[val] || `${val} Stars`;
            }
        }

        function toggleFeedbackTag(btn, tag) {
            if (selectedFeedbackTags.has(tag)) {
                selectedFeedbackTags.delete(tag);
                btn.classList.remove('btn-warning', 'text-dark', 'fw-semibold');
                btn.classList.add('btn-outline-secondary');
            } else {
                selectedFeedbackTags.add(tag);
                btn.classList.add('btn-warning', 'text-dark', 'fw-semibold');
                btn.classList.remove('btn-outline-secondary');
            }
        }

        async function submitCustomerFeedback() {
            const btn = document.getElementById('btnSubmitFeedback');
            const name = document.getElementById('feedbackCustomerName')?.value || "";
            const comment = document.getElementById('feedbackComment')?.value || "";

            if (btn) btn.disabled = true;

            try {
                const response = await fetch('/api/order/feedback', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderToken: orderToken,
                        overallRating: feedbackRatings.Overall,
                        foodRating: feedbackRatings.Food,
                        serviceRating: feedbackRatings.Service,
                        customerName: name,
                        tags: Array.from(selectedFeedbackTags),
                        comment: comment
                    })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    const formBox = document.getElementById('feedbackFormContainer');
                    const successBox = document.getElementById('feedbackSuccessContainer');
                    if (formBox) formBox.classList.add('d-none');
                    if (successBox) successBox.classList.remove('d-none');
                } else {
                    alert(data.message || "Failed to submit feedback.");
                    if (btn) btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert("Network error.");
                if (btn) btn.disabled = false;
            }
        }

        let trackServiceType = "Assistance";
        let trackModalInstance = null;

        function openTrackWaiterModal() {
            if (!trackModalInstance) {
                trackModalInstance = new bootstrap.Modal(document.getElementById('trackWaiterModal'));
            }
            document.getElementById('trackCallAlert').classList.add('d-none');
            document.getElementById('btnSendTrackService').disabled = false;
            trackModalInstance.show();
        }

        function setTrackServiceType(type, el) {
            trackServiceType = type;
            document.querySelectorAll('.track-opt').forEach(b => b.classList.remove('active', 'border-warning', 'bg-warning-subtle'));
            el.classList.add('active', 'border-warning', 'bg-warning-subtle');
        }

        async function sendTrackServiceCall() {
            const btn = document.getElementById('btnSendTrackService');
            const alertBox = document.getElementById('trackCallAlert');
            btn.disabled = true;

            try {
                const response = await fetch('/api/table/call-waiter', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        restaurantSlug: "@Model.Restaurant.Slug",
                        tableToken: "@Model.Table.Token",
                        requestType: trackServiceType,
                        notes: `Order #${"@Model.Order.OrderNumber"}`
                    })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    alertBox.classList.remove('d-none');
                    setTimeout(() => {
                        if (trackModalInstance) trackModalInstance.hide();
                    }, 2000);
                } else {
                    alert(data.message || "Failed to notify staff.");
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert("Network error.");
                btn.disabled = false;
            }
        }

        let upiModalInstance = null;
        let activeHandle = 'upi';

        async function openUpiCheckoutModal(handle = 'upi') {
            activeHandle = handle;
            if (!upiModalInstance) {
                upiModalInstance = bootstrap.Modal.getOrCreateInstance(document.getElementById('upiCheckoutModal'));
            }
            
            const spinner = document.getElementById('upiLoadingSpinner');
            const content = document.getElementById('upiModalContent');
            if (spinner) spinner.classList.remove('d-none');
            if (content) content.classList.add('d-none');

            upiModalInstance.show();
            await fetchUpiDetails(activeHandle);
        }

        async function fetchUpiDetails(handle) {
            const spinner = document.getElementById('upiLoadingSpinner');
            const content = document.getElementById('upiModalContent');

            try {
                const response = await fetch(`/api/order/upi-payment-details/${orderToken}?handle=${handle}`);
                const data = await response.json();

                if (response.ok && data.success) {
                    if (data.isAlreadyPaid) {
                        if (upiModalInstance) upiModalInstance.hide();
                        alert("This order is already settled!");
                        window.location.reload();
                        return;
                    }

                    const qrImage = document.getElementById('upiQrImage');
                    if (qrImage) qrImage.src = data.upiQrDataUri;

                    const amtText = document.getElementById('upiAmountText');
                    if (amtText) amtText.innerText = data.grandTotal.toFixed(2);

                    const idText = document.getElementById('upiIdText');
                    if (idText) idText.innerText = data.upiId;

                    const phoneText = document.getElementById('upiPhoneText');
                    if (phoneText && data.phoneNumber) {
                        phoneText.innerText = data.phoneNumber;
                    }

                    // Direct App links
                    const btnGeneric = document.getElementById('btnDirectUpiIntent');
                    if (btnGeneric) btnGeneric.href = data.upiUri;

                    const btnGPay = document.getElementById('btnDirectGPay');
                    if (btnGPay) btnGPay.href = data.appUris?.gpay || data.upiUri;

                    const btnPhonePe = document.getElementById('btnDirectPhonePe');
                    if (btnPhonePe) btnPhonePe.href = data.appUris?.phonepe || data.upiUri;

                    const btnPaytm = document.getElementById('btnDirectPaytm');
                    if (btnPaytm) btnPaytm.href = data.appUris?.paytm || data.upiUri;

                    // Update handle buttons active styling
                    const buttons = document.querySelectorAll('.upi-handle-btn');
                    buttons.forEach(btn => {
                        if (btn.getAttribute('data-handle') === handle) {
                            btn.className = "btn btn-sm btn-primary rounded-pill px-3 upi-handle-btn";
                        } else {
                            btn.className = "btn btn-sm btn-outline-secondary rounded-pill px-3 upi-handle-btn";
                        }
                    });

                    if (spinner) spinner.classList.add('d-none');
                    if (content) content.classList.remove('d-none');
                } else {
                    alert(data.message || "Unable to fetch UPI details.");
                    if (upiModalInstance) upiModalInstance.hide();
                }
            } catch (err) {
                console.error("UPI Checkout fetch error:", err);
                alert("Failed to load payment details: " + (err.message || "Network error"));
                if (upiModalInstance) upiModalInstance.hide();
            }
        }

        async function switchUpiHandle(handle, btnElem) {
            activeHandle = handle;
            const buttons = document.querySelectorAll('.upi-handle-btn');
            buttons.forEach(btn => {
                btn.className = "btn btn-sm btn-outline-secondary rounded-pill px-3 upi-handle-btn";
            });
            if (btnElem) {
                btnElem.className = "btn btn-sm btn-primary rounded-pill px-3 upi-handle-btn";
            }

            const qrImg = document.getElementById('upiQrImage');
            if (qrImg) qrImg.style.opacity = '0.4';

            await fetchUpiDetails(handle);

            if (qrImg) qrImg.style.opacity = '1.0';
        }

        function copyUpiText(text, btn) {
            navigator.clipboard.writeText(text).then(() => {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = `<i class="bi bi-check2 me-1"></i>Copied!`;
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-success');
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-outline-secondary');
                }, 2000);
            }).catch(err => {
                console.error('Copy failed', err);
            });
        }

        async function simulateUpiPayment() {
            const btn = document.getElementById('btnSimulateUpiPay');
            if (btn) btn.disabled = true;

            const utrInput = document.getElementById('upiUtrNumberInput');
            const utrVal = utrInput ? utrInput.value.trim() : '';
            const paymentRef = utrVal ? `UTR-${utrVal}` : `UPI-APP-${Date.now()}`;

            try {
                const response = await fetch('/api/order/confirm-online-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        orderToken: orderToken,
                        paymentMethod: "UPI",
                        paymentReference: paymentRef
                    })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    if (upiModalInstance) upiModalInstance.hide();

                    const unpaidSec = document.getElementById('paymentUnpaidSection');
                    const paidSec = document.getElementById('paymentPaidSection');
                    const badge = document.getElementById('badgePaymentStatus');
                    const billNumTxt = document.getElementById('paidBillNumberText');
                    const receiptNumTxt = document.getElementById('receiptBillNum');
                    const successAlert = document.getElementById('paymentSuccessAlert');

                    if (unpaidSec) unpaidSec.classList.add('d-none');
                    if (paidSec) paidSec.classList.remove('d-none');
                    if (billNumTxt) billNumTxt.innerText = data.billNumber;
                    if (receiptNumTxt) receiptNumTxt.innerText = data.billNumber;

                    if (badge) {
                        badge.className = "badge bg-success rounded-pill px-3 py-1";
                        badge.innerText = "✓ Paid & Settled";
                    }

                    if (successAlert) {
                        successAlert.classList.remove('d-none');
                    }

                    const feedbackCard = document.getElementById('customerFeedbackCard');
                    if (feedbackCard) feedbackCard.classList.remove('d-none');

                    // Receipt is NOT auto-opened. Diner can click 'View Tax Receipt' when ready.
                } else {
                    alert(data.message || "Payment verification failed.");
                    if (btn) btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert("Network error confirming payment.");
                if (btn) btn.disabled = false;
            }
        }

        function openReceiptModal() {
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('receiptModal'));
            modal.show();
        }
    </script>
}
