@model MenuScan.Models.ViewModels.CustomerMenuViewModel
@{
    ViewData["Title"] = $"{Model.Restaurant.Name} - Coffee & Food Menu";
    Layout = "_Layout";
}

<div class="container-fluid px-3 px-lg-4 py-3">
    <div class="row g-4">
        
        <!-- Left Sidebar (Desktop / Tablet Navigation - Image 1) -->
        <aside class="col-lg-2 d-none d-lg-block">
            <div class="cafe-sidebar shadow-sm">
                <div class="d-flex align-items-center mb-4 ps-2">
                    <span class="fs-3 me-2">☕</span>
                    <div>
                        <h5 class="mb-0 fw-bold" style="letter-spacing: -0.5px;">@Model.Restaurant.Name</h5>
                        <small class="text-muted"><i class="bi bi-geo-alt"></i> @Model.Table.TableNumber</small>
                    </div>
                </div>

                <nav class="d-flex flex-column gap-1">
                    <a href="#" class="cafe-sidebar-nav-item active">
                        <i class="bi bi-journal-text me-3 fs-5"></i> Menu
                    </a>
                    <a href="javascript:void(0)" onclick="openCartModal()" class="cafe-sidebar-nav-item d-flex justify-content-between">
                        <span><i class="bi bi-bag me-3 fs-5"></i> My Cart</span>
                        <span class="badge rounded-pill bg-danger" id="sidebarCartCount">0</span>
                    </a>
                    <a href="/Account/Login" class="cafe-sidebar-nav-item">
                        <i class="bi bi-shield-lock me-3 fs-5"></i> Staff Portal
                    </a>
                </nav>

                <div class="mt-5 pt-5 border-top border-2 border-white">
                    <div class="p-3 bg-white rounded-4 shadow-sm text-center">
                        <small class="text-muted d-block mb-1">Dine-in at</small>
                        <span class="badge bg-dark fs-6 px-3 py-2 rounded-pill">@Model.Table.TableNumber</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area (Images 1 & 2) -->
        <main class="col-12 col-lg-7 col-xl-7">
            
            <!-- Mobile Top Header (Image 2) -->
            <div class="d-flex d-lg-none justify-content-between align-items-center mb-3 pt-1">
                <div>
                    <h4 class="mb-0 fw-bold">@Model.Restaurant.Name</h4>
                    <span class="badge bg-secondary-subtle text-dark border">
                        <i class="bi bi-qr-code me-1"></i> @Model.Table.TableNumber
                    </span>
                </div>
                <button class="btn btn-outline-dark position-relative rounded-circle p-2" style="width: 44px; height: 44px;" onclick="openCartModal()">
                    <i class="bi bi-bag fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="mobileHeaderCartCount">0</span>
                </button>
            </div>

            <!-- Top Search & Filter Bar -->
            <div class="row g-2 align-items-center mb-4">
                <div class="col position-relative">
                    <i class="bi bi-search cafe-search-icon"></i>
                    <input type="text" id="menuSearchInput" class="form-control cafe-search-box w-100" placeholder="Search coffee, food & more..." oninput="handleSearch(this.value)" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-cafe-outline d-flex align-items-center gap-2" onclick="toggleVegFilter(this)" id="vegFilterBtn">
                        <i class="bi bi-sliders"></i> <span class="d-none d-sm-inline">Veg Only</span>
                    </button>
                </div>
            </div>

            <!-- Mobile Hero Promo Banner (Image 2) -->
            <div class="cafe-promo-banner mb-4">
                <div class="row align-items-center">
                    <div class="col-7 col-sm-8">
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 mb-2 fw-semibold" style="font-size: 11px;">
                            FRESH BREW
                        </span>
                        <h3 class="mb-2">Good Coffee<br />Good Vibes</h3>
                        <p class="mb-3 d-none d-sm-block">Freshly handcrafted coffee & artisan bites made to brighten your day.</p>
                        <a href="#cat-pills-row" class="btn btn-cafe-primary btn-sm px-3 py-2">
                            ORDER NOW <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <div class="col-5 col-sm-4 text-center">
                        <img src="https://images.unsplash.com/photo-1534778101976-62847782c213?auto=format&fit=crop&w=300&q=80" 
                             alt="Coffee Cup" class="img-fluid rounded-4 shadow" style="max-height: 130px; object-fit: cover;" />
                    </div>
                </div>
            </div>

            <!-- Circular Category Icons Row (Image 2) -->
            <div class="d-flex overflow-auto gap-3 pb-3 mb-3 text-center no-scrollbar" id="cat-circle-row" style="white-space: nowrap;">
                <div class="cafe-circle-item active flex-shrink-0" onclick="filterByCategory('all', this)">
                    <div class="cafe-circle-icon"><i class="bi bi-cup-hot-fill"></i></div>
                    <div class="cafe-circle-label">All</div>
                </div>
                @foreach (var cat in Model.Categories)
                {
                    var iconClass = cat.Name.ToLower().Contains("coffee") ? "bi-cup-hot" :
                                    cat.Name.ToLower().Contains("food") || cat.Name.ToLower().Contains("sand") ? "bi-egg-fried" :
                                    cat.Name.ToLower().Contains("pastr") || cat.Name.ToLower().Contains("dessert") ? "bi-cake2" : "bi-tropical-storm";
                    
                    <div class="cafe-circle-item flex-shrink-0" onclick="filterByCategory('@cat.Id', this)">
                        <div class="cafe-circle-icon"><i class="bi @iconClass"></i></div>
                        <div class="cafe-circle-label">@cat.Name</div>
                    </div>
                }
            </div>

            <!-- Category Pills Bar (Image 1) -->
            <div class="d-flex overflow-auto gap-2 mb-4 pb-1 no-scrollbar" id="cat-pills-row" style="white-space: nowrap;">
                <button class="cafe-cat-pill active" onclick="filterByCategory('all', this)">All Menu</button>
                @foreach (var cat in Model.Categories)
                {
                    <button class="cafe-cat-pill" onclick="filterByCategory('@cat.Id', this)">@cat.Name</button>
                }
            </div>

            <!-- Products Section Title -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0" id="sectionTitle">Menu Items</h4>
                <small class="text-muted" id="itemCountText">Showing all items</small>
            </div>

            <!-- Products Grid (Image 1 & 2 Cards) -->
            <div class="row g-3 g-md-4" id="productsGrid">
                @foreach (var cat in Model.Categories)
                {
                    @foreach (var item in cat.MenuItems)
                    {
                        var badgeType = item.Name.Contains("Cappuccino") || item.Name.Contains("Pizza") ? "BESTSELLER" :
                                        item.Name.Contains("Muffin") || item.Name.Contains("V60") ? "CHEF'S PICK" : "POPULAR";
                        var badgeClass = badgeType == "BESTSELLER" ? "cafe-badge-bestseller" :
                                         badgeType == "CHEF'S PICK" ? "cafe-badge-chef" : "cafe-badge-popular";
                        var rating = (4.6 + (item.Name.Length % 4) * 0.1).ToString("0.0");
                        var ratingCount = (500 + (item.Name.Length * 47));
                        var hasCustomizations = item.Customizations.Any();

                        <div class="col-12 col-sm-6 col-xl-4 product-item-wrapper" 
                             data-cat-id="@cat.Id" 
                             data-name="@item.Name.ToLower()" 
                             data-is-veg="@item.IsVeg.ToString().ToLower()">
                            
                            <div class="cafe-product-card">
                                <!-- Card Image -->
                                <div class="cafe-card-img-wrap mb-3">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1509785307050-d4066910ec1e?auto=format&fit=crop&w=600&q=80" : item.ImageUrl)" 
                                         alt="@item.Name" class="cafe-card-img" loading="lazy" />
                                    <span class="cafe-badge @badgeClass">@badgeType</span>
                                </div>

                                <!-- Card Details -->
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <h6 class="fw-bold mb-0 text-truncate me-2" style="font-size: 16px;">@item.Name</h6>
                                    <span class="fw-bold text-dark fs-6" style="color: var(--cafe-primary) !important;">
                                        ₹@item.Price.ToString("0.00")
                                    </span>
                                </div>

                                <!-- Rating & Dietary Tag -->
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="text-warning small fw-bold">★ @rating</span>
                                    <span class="text-muted small">(@ratingCount+)</span>
                                    @if (item.IsVeg)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success ms-auto" style="font-size: 10px;">VEG</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger ms-auto" style="font-size: 10px;">NON-VEG</span>
                                    }
                                </div>

                                <p class="text-muted small mb-3 flex-grow-1" style="font-size: 13px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.Description
                                </p>

                                <!-- Customization Badges / Hints -->
                                @if (hasCustomizations)
                                {
                                    <div class="d-flex gap-1 mb-3 overflow-hidden text-truncate" style="cursor: pointer;" onclick="openCustomizationModal('@item.Id')">
                                        <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">
                                            <i class="bi bi-sliders me-1"></i> @item.Customizations.Count Options / Sizes
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-3">
                                        <span class="cafe-size-pill active">Standard</span>
                                    </div>
                                }

                                <!-- Bottom Action Controls -->
                                <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top border-light">
                                    @if (hasCustomizations)
                                    {
                                        <button class="btn btn-cafe-outline btn-sm w-100 fw-bold" onclick="openCustomizationModal('@item.Id')">
                                            <i class="bi bi-plus-lg me-1"></i> Customize &amp; Add
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="cafe-stepper">
                                            <button class="cafe-stepper-btn" onclick="updateQty('@item.Id', -1)">-</button>
                                            <span class="cafe-stepper-val" id="qty-val-@item.Id">1</span>
                                            <button class="cafe-stepper-btn" onclick="updateQty('@item.Id', 1)">+</button>
                                        </div>
                                        <button class="btn btn-cafe-primary btn-sm px-3" onclick="addDirectToCart('@item.Id', '@item.Name', @item.Price, '@item.ImageUrl')">
                                            Add to Cart
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </main>

        <!-- Right Side Cart Summary Panel (Desktop / Tablet - Image 1) -->
        <aside class="col-lg-3 col-xl-3 d-none d-lg-block">
            <div class="cafe-cart-panel">
                <h5 class="fw-bold mb-3">Cart summary</h5>

                <!-- Service Switcher (Delivery / Dine in / Take away) -->
                <div class="d-flex gap-1 mb-3 bg-light p-1 rounded-pill">
                    <span class="cafe-service-pill"><i class="bi bi-truck me-1"></i>Delivery</span>
                    <span class="cafe-service-pill active"><i class="bi bi-cup-straw me-1"></i>Dine in</span>
                    <span class="cafe-service-pill"><i class="bi bi-bag me-1"></i>Take away</span>
                </div>

                <div class="badge bg-light text-dark border w-100 py-2 mb-3 fs-6">
                    Seated at: <strong class="text-primary">@Model.Table.TableNumber</strong>
                </div>

                <!-- Desktop Cart Items List -->
                <div id="desktopCartItems" class="mb-3" style="max-height: 280px; overflow-y: auto;">
                    <div class="text-center text-muted py-4 small">
                        <i class="bi bi-cup display-6 d-block mb-2 text-black-50"></i>
                        Your order is empty.<br />Click "+ Add to Cart" to start.
                    </div>
                </div>

                <!-- Notes input -->
                <div class="mb-3">
                    <input type="text" id="desktopNotes" class="form-control form-control-sm rounded-pill" placeholder="Cooking instructions (e.g. less ice)..." />
                </div>

                <!-- Bill breakdown -->
                <div class="pt-3 border-top">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Price</span>
                        <span>₹<span id="dtSubTotal">0.00</span></span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Taxes (@Model.Restaurant.DefaultTaxRate%)</span>
                        <span>₹<span id="dtTax">0.00</span></span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-2 mb-3">
                        <span>Grand total</span>
                        <span style="color: var(--cafe-primary);">₹<span id="dtGrandTotal">0.00</span></span>
                    </div>

                    <button class="btn btn-cafe-primary w-100 py-3 fw-bold" id="btnDesktopPlaceOrder" onclick="placeOrder('desktopNotes')" disabled>
                        Place an order
                    </button>
                </div>
            </div>
        </aside>

    </div>
</div>

<!-- Customization Popup Modal -->
<div class="modal fade" id="customizationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-3" style="background-color: #241812;">
                <h5 class="modal-title fw-bold" id="customModalTitle">
                    <i class="bi bi-sliders me-2" style="color: var(--cafe-primary);"></i>Customize Your Order
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <img id="customModalImg" src="" class="rounded-3 me-3" style="width: 64px; height: 64px; object-fit: cover;" />
                    <div>
                        <h5 class="fw-bold mb-1" id="customModalItemName">Item Name</h5>
                        <div class="text-muted small">Base price: ₹<span id="customModalBasePrice">0.00</span></div>
                    </div>
                </div>

                <hr class="my-3" />

                <h6 class="fw-bold small text-uppercase text-muted mb-2">Available Add-ons &amp; Sizes:</h6>
                <div id="customModalOptionsList" class="mb-4">
                    <!-- Populated dynamically -->
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-4 mb-3" style="background-color: var(--cafe-primary-light);">
                    <span class="fw-bold">Item Price (with Options):</span>
                    <span class="fs-4 fw-bold" style="color: var(--cafe-primary);">₹<span id="customModalCalculatedPrice">0.00</span></span>
                </div>

                <button type="button" class="btn btn-cafe-primary w-100 py-3 fw-bold" id="btnCustomAddCart" onclick="confirmCustomizationAndAdd()">
                    Add to Cart
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Bottom Docked Cart Bar (Image 2) -->
<div id="mobileCartBar" class="d-lg-none fixed-bottom bg-white border-top shadow-lg p-3 d-none" style="z-index: 1040;">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <span class="badge rounded-pill bg-danger me-2" id="mobileCartBadge">0</span>
            <span class="fw-bold fs-6">₹<span id="mobileCartTotalText">0.00</span></span>
            <small class="text-muted d-block" style="font-size: 11px;">(incl. @Model.Restaurant.DefaultTaxRate% tax)</small>
        </div>
        <button class="btn btn-cafe-primary px-4 fw-bold" onclick="openCartModal()">
            View Cart <i class="bi bi-chevron-right ms-1"></i>
        </button>
    </div>
</div>

<!-- Cart Offcanvas Modal (for Mobile or Quick Review) -->
<div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-3" style="background-color: #241812;">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-cup-hot me-2" style="color: var(--cafe-primary);"></i>Your Order (@Model.Table.TableNumber)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div id="modalCartItems" class="mb-3">
                    <!-- Populated dynamically -->
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Special instructions for the barista &amp; chef:</label>
                    <textarea id="modalNotes" class="form-control rounded-3" rows="2" placeholder="e.g. Extra hot, separate bag..."></textarea>
                </div>

                <div class="bg-light p-3 rounded-4">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Items Subtotal</span>
                        <span>₹<span id="modalSubTotal">0.00</span></span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>GST / Taxes (@Model.Restaurant.DefaultTaxRate%)</span>
                        <span>₹<span id="modalTax">0.00</span></span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-4 border-top pt-2">
                        <span>Grand Total</span>
                        <span style="color: var(--cafe-primary);">₹<span id="modalGrandTotal">0.00</span></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Add More</button>
                <button type="button" class="btn btn-cafe-primary fw-bold px-4" id="btnModalPlaceOrder" onclick="placeOrder('modalNotes')">
                    Confirm & Send to Kitchen
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const restaurantSlug = "@Model.Restaurant.Slug";
        const tableToken = "@Model.Table.Token";
        const taxRate = @Model.Restaurant.DefaultTaxRate;
        
        // Build items data catalog with customizations in JS
        const menuCatalog = {
            @foreach (var cat in Model.Categories)
            {
                foreach (var item in cat.MenuItems)
                {
                    <text>
                    "@item.Id": {
                        name: "@Html.Raw(item.Name)",
                        price: @item.Price,
                        img: "@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1509785307050-d4066910ec1e?auto=format&fit=crop&w=600&q=80" : item.ImageUrl)",
                        customizations: [
                            @foreach (var c in item.Customizations)
                            {
                                <text>{ id: "@c.Id", name: "@Html.Raw(c.Name)", price: @c.Price },</text>
                            }
                        ]
                    },
                    </text>
                }
            }
        };

        let cart = {}; // key -> { menuItemId, name, price, qty, img, customizationIds, customizationSummary }
        let isVegOnly = false;
        let currentSearch = "";
        let currentCatId = "all";
        let activeCustomItemId = null;
        let customModalInstance = null;

        function addDirectToCart(id, name, price, img) {
            const stepperVal = parseInt(document.getElementById(`qty-val-${id}`)?.innerText || "1");
            const key = id;
            if (!cart[key]) {
                cart[key] = {
                    menuItemId: id,
                    name: name,
                    price: price,
                    qty: stepperVal,
                    img: img,
                    customizationIds: [],
                    customizationSummary: ""
                };
            } else {
                cart[key].qty += stepperVal;
            }
            updateCartUI();
        }

        function openCustomizationModal(itemId) {
            activeCustomItemId = itemId;
            const item = menuCatalog[itemId];
            if (!item) return;

            document.getElementById('customModalItemName').innerText = item.name;
            document.getElementById('customModalBasePrice').innerText = item.price.toFixed(2);
            document.getElementById('customModalImg').src = item.img;
            document.getElementById('customModalCalculatedPrice').innerText = item.price.toFixed(2);

            let optionsHtml = '';
            item.customizations.forEach((c, idx) => {
                optionsHtml += `
                    <div class="form-check p-3 mb-2 border rounded-3 d-flex align-items-center justify-content-between" style="background: #FAFAFA;">
                        <div>
                            <input class="form-check-input me-2 custom-check-opt" type="checkbox" id="opt_${c.id}" value="${c.id}" data-price="${c.price}" data-name="${c.name}" onchange="recalcCustomModal()">
                            <label class="form-check-label fw-semibold" for="opt_${c.id}" style="cursor: pointer;">
                                ${c.name}
                            </label>
                        </div>
                        <span class="badge bg-light text-dark border">+₹${c.price.toFixed(2)}</span>
                    </div>
                `;
            });

            document.getElementById('customModalOptionsList').innerHTML = optionsHtml;
            customModalInstance = new bootstrap.Modal(document.getElementById('customizationModal'));
            customModalInstance.show();
        }

        function recalcCustomModal() {
            if (!activeCustomItemId) return;
            const item = menuCatalog[activeCustomItemId];
            let total = item.price;
            document.querySelectorAll('.custom-check-opt:checked').forEach(cb => {
                total += parseFloat(cb.getAttribute('data-price') || "0");
            });
            document.getElementById('customModalCalculatedPrice').innerText = total.toFixed(2);
        }

        function confirmCustomizationAndAdd() {
            if (!activeCustomItemId) return;
            const item = menuCatalog[activeCustomItemId];
            let lineUnitPrice = item.price;
            const selectedIds = [];
            const selectedNames = [];

            document.querySelectorAll('.custom-check-opt:checked').forEach(cb => {
                lineUnitPrice += parseFloat(cb.getAttribute('data-price') || "0");
                selectedIds.push(cb.value);
                selectedNames.Add ? selectedNames.Add(cb.getAttribute('data-name')) : selectedNames.push(cb.getAttribute('data-name'));
            });

            selectedIds.sort();
            const key = activeCustomItemId + "_" + selectedIds.join("_");
            const summaryText = selectedNames.join(", ");

            if (!cart[key]) {
                cart[key] = {
                    menuItemId: activeCustomItemId,
                    name: item.name,
                    price: lineUnitPrice,
                    qty: 1,
                    img: item.img,
                    customizationIds: selectedIds,
                    customizationSummary: summaryText
                };
            } else {
                cart[key].qty++;
            }

            if (customModalInstance) customModalInstance.hide();
            updateCartUI();
        }

        function updateCartQty(key, change) {
            if (cart[key]) {
                cart[key].qty += change;
                if (cart[key].qty <= 0) {
                    delete cart[key];
                }
            }
            updateCartUI();
        }

        function updateQty(id, change) {
            const el = document.getElementById(`qty-val-${id}`);
            if (el) {
                let cur = parseInt(el.innerText);
                cur = Math.max(1, cur + change);
                el.innerText = cur;
            }
        }

        function updateCartUI() {
            let totalCount = 0;
            let subtotal = 0;

            for (const key in cart) {
                totalCount += cart[key].qty;
                subtotal += cart[key].price * cart[key].qty;
            }

            const tax = subtotal * (taxRate / 100);
            const grandTotal = subtotal + tax;

            // Badges
            document.getElementById('sidebarCartCount').innerText = totalCount;
            document.getElementById('mobileHeaderCartCount').innerText = totalCount;
            document.getElementById('mobileCartBadge').innerText = totalCount;
            document.getElementById('mobileCartTotalText').innerText = grandTotal.toFixed(2);

            // Floating bottom bar toggle
            const mobileBar = document.getElementById('mobileCartBar');
            if (totalCount > 0) {
                mobileBar.classList.remove('d-none');
            } else {
                mobileBar.classList.add('d-none');
            }

            // Summaries
            document.getElementById('dtSubTotal').innerText = subtotal.toFixed(2);
            document.getElementById('dtTax').innerText = tax.toFixed(2);
            document.getElementById('dtGrandTotal').innerText = grandTotal.toFixed(2);
            document.getElementById('btnDesktopPlaceOrder').disabled = totalCount === 0;

            document.getElementById('modalSubTotal').innerText = subtotal.toFixed(2);
            document.getElementById('modalTax').innerText = tax.toFixed(2);
            document.getElementById('modalGrandTotal').innerText = grandTotal.toFixed(2);

            // Render Items HTML for Desktop Panel & Modal
            const desktopContainer = document.getElementById('desktopCartItems');
            const modalContainer = document.getElementById('modalCartItems');

            if (totalCount === 0) {
                desktopContainer.innerHTML = `
                    <div class="text-center text-muted py-4 small">
                        <i class="bi bi-cup display-6 d-block mb-2 text-black-50"></i>
                        Your order is empty.<br />Click "+ Add to Cart" to start.
                    </div>`;
                modalContainer.innerHTML = '<div class="text-center text-muted py-3">Your cart is empty.</div>';
            } else {
                let html = '';
                for (const key in cart) {
                    const it = cart[key];
                    html += `
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div class="d-flex align-items-center me-2 text-truncate">
                                <img src="${it.img}" class="rounded-3 me-2" style="width: 44px; height: 44px; object-fit: cover;" />
                                <div class="text-truncate">
                                    <h6 class="mb-0 fw-bold small text-truncate">${it.name}</h6>
                                    ${it.customizationSummary ? `<div class="small text-muted" style="font-size: 11px;">${it.customizationSummary}</div>` : ''}
                                    <span class="small fw-semibold" style="color: var(--cafe-primary);">₹${it.price.toFixed(2)}</span>
                                </div>
                            </div>
                            <div class="cafe-stepper">
                                <button class="cafe-stepper-btn" onclick="updateCartQty('${key}', -1)">-</button>
                                <span class="cafe-stepper-val">${it.qty}</span>
                                <button class="cafe-stepper-btn" onclick="updateCartQty('${key}', 1)">+</button>
                            </div>
                        </div>
                    `;
                }
                desktopContainer.innerHTML = html;
                modalContainer.innerHTML = html;
            }
        }

        function filterByCategory(catId, element) {
            currentCatId = catId;
            document.querySelectorAll('.cafe-cat-pill, .cafe-circle-item').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
            applyFilters();
        }

        function handleSearch(val) {
            currentSearch = val.toLowerCase().trim();
            applyFilters();
        }

        function toggleVegFilter(btn) {
            isVegOnly = !isVegOnly;
            btn.classList.toggle('active', isVegOnly);
            btn.classList.toggle('btn-success', isVegOnly);
            btn.classList.toggle('btn-cafe-outline', !isVegOnly);
            applyFilters();
        }

        function applyFilters() {
            let visibleCount = 0;
            document.querySelectorAll('.product-item-wrapper').forEach(card => {
                const itemCat = card.getAttribute('data-cat-id');
                const itemName = card.getAttribute('data-name');
                const isVeg = card.getAttribute('data-is-veg') === 'true';

                const matchesCat = currentCatId === 'all' || itemCat === currentCatId;
                const matchesSearch = !currentSearch || itemName.includes(currentSearch);
                const matchesVeg = !isVegOnly || isVeg;

                if (matchesCat && matchesSearch && matchesVeg) {
                    card.classList.remove('d-none');
                    visibleCount++;
                } else {
                    card.classList.add('d-none');
                }
            });

            document.getElementById('itemCountText').innerText = `Showing ${visibleCount} items`;
        }

        function openCartModal() {
            const m = new bootstrap.Modal(document.getElementById('cartModal'));
            m.show();
        }

        async function placeOrder(notesInputId) {
            const items = [];
            for (const key in cart) {
                items.push({
                    menuItemId: cart[key].menuItemId,
                    quantity: cart[key].qty,
                    customizationIds: cart[key].customizationIds || [],
                    customizationSummary: cart[key].customizationSummary || ""
                });
            }

            if (items.length === 0) {
                alert("Your cart is empty!");
                return;
            }

            const notes = document.getElementById(notesInputId)?.value || "";
            const btn = document.getElementById('btnDesktopPlaceOrder');
            const modalBtn = document.getElementById('btnModalPlaceOrder');

            if (btn) btn.disabled = true;
            if (modalBtn) modalBtn.disabled = true;

            const idempotencyKey = crypto.randomUUID();

            try {
                const response = await fetch('/api/orders/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        restaurantSlug: restaurantSlug,
                        tableToken: tableToken,
                        idempotencyKey: idempotencyKey,
                        customerNotes: notes,
                        items: items
                    })
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    window.location.href = result.redirectUrl;
                } else {
                    alert(result.message || "Failed to place order.");
                    if (btn) btn.disabled = false;
                    if (modalBtn) modalBtn.disabled = false;
                }
            } catch (e) {
                console.error(e);
                alert("Network error.");
                if (btn) btn.disabled = false;
                if (modalBtn) modalBtn.disabled = false;
            }
        }
    </script>
}
