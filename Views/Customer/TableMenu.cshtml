@model MenuScan.Models.ViewModels.CustomerMenuViewModel
@{
    ViewData["Title"] = $"{Model.Restaurant.Name} - Menu";
    Layout = "_Layout";
}

<!-- Customer Menu Header -->
<div class="bg-dark text-white py-3 px-3 shadow-sm sticky-top" style="z-index: 1020;">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 fw-bold">@Model.Restaurant.Name</h5>
            <small class="text-white-50"><i class="bi bi-geo-alt"></i> @Model.Table.TableNumber</small>
        </div>
        <div>
            <span class="badge bg-success py-2 px-3 fs-6">
                <i class="bi bi-qr-code-scan me-1"></i> @Model.Table.TableNumber
            </span>
        </div>
    </div>

    <!-- Category Nav Pills -->
    <div class="d-flex overflow-auto mt-2 pt-1 pb-1 gap-2 no-scrollbar" style="white-space: nowrap;">
        <button class="btn btn-sm btn-outline-light active rounded-pill px-3" onclick="filterCategory('all', this)">All</button>
        <button class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="toggleVegOnly(this)">
            <i class="bi bi-circle-fill text-success me-1"></i>Veg Only
        </button>
        @foreach (var cat in Model.Categories)
        {
            <a href="#cat-@cat.Id" class="btn btn-sm btn-outline-light rounded-pill px-3 text-decoration-none">
                @cat.Name
            </a>
        }
    </div>
</div>

<div class="container py-3 mb-5 pb-5">
    @if (!Model.Categories.Any() || !Model.Categories.Any(c => c.MenuItems.Any()))
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-cup-hot display-3"></i>
            <h5 class="mt-3">No menu items available right now.</h5>
            <p>Please ask your server for assistance.</p>
        </div>
    }

    @foreach (var cat in Model.Categories)
    {
        @if (cat.MenuItems.Any())
        {
            <div class="category-section mt-4" id="cat-@cat.Id">
                <h5 class="fw-bold border-bottom pb-2 text-primary">@cat.Name</h5>
                <div class="row g-3 mt-1">
                    @foreach (var item in cat.MenuItems)
                    {
                        <div class="col-12 col-md-6 menu-item-card" data-is-veg="@item.IsVeg.ToString().ToLower()">
                            <div class="card h-100 shadow-sm border-0 rounded-3">
                                <div class="card-body d-flex justify-content-between p-3">
                                    <div class="me-3 flex-grow-1">
                                        <div class="d-flex align-items-center mb-1">
                                            @if (item.IsVeg)
                                            {
                                                <span class="border border-success p-1 rounded-1 me-2 d-inline-block" style="line-height: 0;">
                                                    <i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="border border-danger p-1 rounded-1 me-2 d-inline-block" style="line-height: 0;">
                                                    <i class="bi bi-circle-fill text-danger" style="font-size: 8px;"></i>
                                                </span>
                                            }
                                            <h6 class="mb-0 fw-bold">@item.Name</h6>
                                        </div>
                                        <p class="text-muted small mb-2 text-truncate-2">@item.Description</p>
                                        <div class="fw-bold text-dark fs-6">₹@item.Price.ToString("0.00")</div>
                                    </div>
                                    <div class="d-flex flex-column align-items-center justify-content-center" style="min-width: 90px;">
                                        <div id="btn-container-@item.Id">
                                            <button type="button" class="btn btn-outline-danger btn-sm fw-bold px-3 rounded-pill" onclick="addToCart('@item.Id', '@item.Name', @item.Price)">
                                                + ADD
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Floating Bottom Cart Bar -->
<div id="cartBar" class="fixed-bottom bg-danger text-white py-3 px-4 d-none shadow-lg" style="cursor: pointer;" onclick="openCartModal()">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-white text-danger fw-bold fs-6 me-2" id="cartCountBadge">0</span>
            <span class="fw-bold fs-6">Items in Cart | ₹<span id="cartTotalText">0.00</span></span>
        </div>
        <div class="fw-bold">
            View Cart <i class="bi bi-chevron-right ms-1"></i>
        </div>
    </div>
</div>

<!-- Cart Offcanvas Modal -->
<div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="cartModalLabel">
                    <i class="bi bi-bag-check me-2"></i>Your Order (@Model.Table.TableNumber)
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="cartItemsList" class="mb-3">
                    <!-- Populated dynamically -->
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Special Instructions / Cooking Notes (Optional)</label>
                    <textarea id="customerNotes" class="form-control" rows="2" placeholder="e.g. Less spicy, no onions, extra napkins..."></textarea>
                </div>

                <div class="bg-light p-3 rounded-3">
                    <div class="d-flex justify-content-between text-muted small mb-1">
                        <span>Item Subtotal</span>
                        <span>₹<span id="summarySubTotal">0.00</span></span>
                    </div>
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Taxes (@Model.Restaurant.DefaultTaxRate%)</span>
                        <span>₹<span id="summaryTax">0.00</span></span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-2">
                        <span>Grand Total</span>
                        <span class="text-danger">₹<span id="summaryGrandTotal">0.00</span></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Add More Items</button>
                <button type="button" id="btnPlaceOrder" class="btn btn-danger fw-bold px-4" onclick="placeOrder()">
                    <span id="orderBtnSpinner" class="spinner-border spinner-border-sm d-none me-1" role="status"></span>
                    Confirm & Send to Kitchen
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const restaurantSlug = "@Model.Restaurant.Slug";
        const tableToken = "@Model.Table.Token";
        const taxRate = @Model.Restaurant.DefaultTaxRate;
        let cart = {}; // { itemId: { name, price, qty } }
        let vegOnlyActive = false;

        function addToCart(id, name, price) {
            if (!cart[id]) {
                cart[id] = { name: name, price: price, qty: 1 };
            } else {
                cart[id].qty++;
            }
            updateCartUI();
        }

        function updateQty(id, change) {
            if (cart[id]) {
                cart[id].qty += change;
                if (cart[id].qty <= 0) {
                    delete cart[id];
                }
            }
            updateCartUI();
        }

        function updateCartUI() {
            let totalItems = 0;
            let subtotal = 0;

            for (const id in cart) {
                totalItems += cart[id].qty;
                subtotal += cart[id].price * cart[id].qty;
            }

            // Update item card buttons
            document.querySelectorAll('[id^="btn-container-"]').forEach(el => {
                const id = el.id.replace('btn-container-', '');
                if (cart[id] && cart[id].qty > 0) {
                    el.innerHTML = `
                        <div class="btn-group btn-group-sm rounded-pill border border-danger">
                            <button type="button" class="btn btn-danger btn-sm px-2" onclick="updateQty('${id}', -1)">-</button>
                            <span class="px-2 py-1 fw-bold text-danger bg-white">${cart[id].qty}</span>
                            <button type="button" class="btn btn-danger btn-sm px-2" onclick="updateQty('${id}', 1)">+</button>
                        </div>
                    `;
                } else {
                    const card = el.closest('.menu-item-card');
                    const name = card.querySelector('h6').innerText;
                    const price = parseFloat(card.querySelector('.fs-6').innerText.replace('₹', ''));
                    el.innerHTML = `
                        <button type="button" class="btn btn-outline-danger btn-sm fw-bold px-3 rounded-pill" onclick="addToCart('${id}', '${name}', ${price})">
                            + ADD
                        </button>
                    `;
                }
            });

            // Update floating bar
            const cartBar = document.getElementById('cartBar');
            if (totalItems > 0) {
                cartBar.classList.remove('d-none');
                document.getElementById('cartCountBadge').innerText = totalItems;
                document.getElementById('cartTotalText').innerText = subtotal.toFixed(2);
            } else {
                cartBar.classList.add('d-none');
            }

            // Update summary
            const tax = (subtotal * (taxRate / 100));
            const grandTotal = subtotal + tax;
            document.getElementById('summarySubTotal').innerText = subtotal.toFixed(2);
            document.getElementById('summaryTax').innerText = tax.toFixed(2);
            document.getElementById('summaryGrandTotal').innerText = grandTotal.toFixed(2);

            // Update modal items
            const listEl = document.getElementById('cartItemsList');
            if (totalItems === 0) {
                listEl.innerHTML = '<div class="text-center text-muted py-3">Your cart is empty.</div>';
            } else {
                let html = '';
                for (const id in cart) {
                    const item = cart[id];
                    html += `
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <div>
                                <h6 class="mb-0 fw-semibold">${item.name}</h6>
                                <small class="text-muted">₹${item.price.toFixed(2)} each</small>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="fw-bold me-3">₹${(item.price * item.qty).toFixed(2)}</span>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary btn-sm" onclick="updateQty('${id}', -1)">-</button>
                                    <span class="btn btn-light btn-sm fw-bold disabled">${item.qty}</span>
                                    <button class="btn btn-outline-secondary btn-sm" onclick="updateQty('${id}', 1)">+</button>
                                </div>
                            </div>
                        </div>
                    `;
                }
                listEl.innerHTML = html;
            }
        }

        function openCartModal() {
            const modal = new bootstrap.Modal(document.getElementById('cartModal'));
            modal.show();
        }

        function toggleVegOnly(btn) {
            vegOnlyActive = !vegOnlyActive;
            btn.classList.toggle('active', vegOnlyActive);
            document.querySelectorAll('.menu-item-card').forEach(card => {
                if (vegOnlyActive && card.getAttribute('data-is-veg') !== 'true') {
                    card.classList.add('d-none');
                } else {
                    card.classList.remove('d-none');
                }
            });
        }

        async function placeOrder() {
            const items = [];
            for (const id in cart) {
                items.push({ menuItemId: id, quantity: cart[id].qty });
            }

            if (items.length === 0) {
                alert("Your cart is empty!");
                return;
            }

            const btn = document.getElementById('btnPlaceOrder');
            const spinner = document.getElementById('orderBtnSpinner');
            btn.disabled = true;
            spinner.classList.remove('d-none');

            // Generate UUID idempotency key
            const idempotencyKey = crypto.randomUUID();
            const notes = document.getElementById('customerNotes').value;

            try {
                const response = await fetch('/api/orders/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        restaurantSlug: restaurantSlug,
                        tableToken: tableToken,
                        idempotencyKey: idempotencyKey,
                        customerNotes: notes,
                        items: items
                    })
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    // Redirect to tracking page
                    window.location.href = result.redirectUrl;
                } else {
                    alert(result.message || "Failed to submit order. Please try again.");
                    btn.disabled = false;
                    spinner.classList.add('d-none');
                }
            } catch (err) {
                console.error(err);
                alert("Network error. Please check your connection and try again.");
                btn.disabled = false;
                spinner.classList.add('d-none');
            }
        }
    </script>
}
