@model MenuScan.Models.ViewModels.CustomerMenuViewModel
@{
    ViewData["Title"] = $"{Model.Restaurant.Name} - Coffee & Food Menu";
    Layout = "_Layout";
}

<div class="container-fluid px-3 px-lg-4 py-3">
    <div class="row g-4">
        
        <!-- Left Sidebar (Desktop / Tablet Navigation - Image 1) -->
        <aside class="col-lg-2 d-none d-lg-block">
            <div class="cafe-sidebar shadow-sm">
                <div class="d-flex align-items-center mb-4 ps-2">
                    <span class="fs-3 me-2">☕</span>
                    <div>
                        <h5 class="mb-0 fw-bold" style="letter-spacing: -0.5px;">@Model.Restaurant.Name</h5>
                        <small class="text-muted"><i class="bi bi-geo-alt"></i> @Model.Table.TableNumber</small>
                    </div>
                </div>

                <nav class="d-flex flex-column gap-1">
                    <a href="#" class="cafe-sidebar-nav-item active">
                        <i class="bi bi-journal-text me-3 fs-5"></i> Menu
                    </a>
                    <a href="javascript:void(0)" onclick="openCartModal()" class="cafe-sidebar-nav-item d-flex justify-content-between">
                        <span><i class="bi bi-bag me-3 fs-5"></i> My Cart</span>
                        <span class="badge rounded-pill bg-danger" id="sidebarCartCount">0</span>
                    </a>
                    <a href="javascript:void(0)" onclick="openCallWaiterModal()" class="cafe-sidebar-nav-item">
                        <i class="bi bi-bell-fill me-3 fs-5 text-warning"></i> Call Waiter
                    </a>
                    <a href="/Account/Login" class="cafe-sidebar-nav-item">
                        <i class="bi bi-shield-lock me-3 fs-5"></i> Staff Portal
                    </a>
                </nav>

                <div class="mt-5 pt-5 border-top border-2 border-white">
                    <div class="p-3 bg-white rounded-4 shadow-sm text-center">
                        <small class="text-muted d-block mb-1">Dine-in at</small>
                        <span class="badge bg-dark fs-6 px-3 py-2 rounded-pill">@Model.Table.TableNumber</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area (Images 1 & 2) -->
        <main class="col-12 col-lg-7 col-xl-7">
            
            <!-- Mobile Top Header (Image 2) -->
            <div class="d-flex d-lg-none justify-content-between align-items-center mb-3 pt-1">
                <div>
                    <h4 class="mb-0 fw-bold">@Model.Restaurant.Name</h4>
                    <span class="badge bg-secondary-subtle text-dark border">
                        <i class="bi bi-qr-code me-1"></i> @Model.Table.TableNumber
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-warning text-dark position-relative rounded-circle p-2" style="width: 44px; height: 44px;" onclick="openCallWaiterModal()" title="Call Waiter / Assistance">
                        <i class="bi bi-bell-fill text-warning fs-5"></i>
                    </button>
                    <button class="btn btn-outline-dark position-relative rounded-circle p-2" style="width: 44px; height: 44px;" onclick="openCartModal()">
                        <i class="bi bi-bag fs-5"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="mobileHeaderCartCount">0</span>
                    </button>
                </div>
            </div>

            <!-- Live Order Success Alert Banner -->
            <div id="orderSuccessBanner" class="alert alert-success alert-dismissible fade show d-none shadow-sm rounded-4 mb-3 border-success" role="alert">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                    <div>
                        <h6 class="alert-heading fw-bold mb-1" id="orderSuccessTitle">Order Sent to Kitchen!</h6>
                        <div class="small text-muted" id="orderSuccessDesc">Your order is being tracked below in your cart. You can also place another round (Dusra Order) anytime.</div>
                    </div>
                </div>
                <button type="button" class="btn-close" onclick="document.getElementById('orderSuccessBanner').classList.add('d-none')"></button>
            </div>

            <!-- Top Search & Filter Bar -->
            <div class="row g-2 align-items-center mb-4">
                <div class="col position-relative">
                    <i class="bi bi-search cafe-search-icon"></i>
                    <input type="text" id="menuSearchInput" class="form-control cafe-search-box w-100" placeholder="Search coffee, food & more..." oninput="handleSearch(this.value)" />
                </div>
                <div class="col-auto d-flex gap-2">
                    <button class="btn btn-outline-warning text-dark d-flex align-items-center gap-1 rounded-pill px-3 fw-semibold" onclick="openCallWaiterModal()">
                        <i class="bi bi-bell-fill text-warning"></i> <span class="d-none d-sm-inline">Call Waiter</span>
                    </button>
                    <button class="btn btn-cafe-outline d-flex align-items-center gap-2" onclick="toggleVegFilter(this)" id="vegFilterBtn">
                        <i class="bi bi-sliders"></i> <span class="d-none d-sm-inline">Veg Only</span>
                    </button>
                </div>
            </div>

            <!-- Mobile Hero Promo Banner (Image 2) -->
            <div class="cafe-promo-banner mb-4">
                <div class="row align-items-center">
                    <div class="col-7 col-sm-8">
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 mb-2 fw-semibold" style="font-size: 11px;">
                            FRESH BREW
                        </span>
                        <h3 class="mb-2">Good Coffee<br />Good Vibes</h3>
                        <p class="mb-3 d-none d-sm-block">Freshly handcrafted coffee & artisan bites made to brighten your day.</p>
                        <a href="#cat-pills-row" class="btn btn-cafe-primary btn-sm px-3 py-2">
                            ORDER NOW <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                    <div class="col-5 col-sm-4 text-center">
                        <img src="https://images.unsplash.com/photo-1534778101976-62847782c213?auto=format&fit=crop&w=300&q=80" 
                             alt="Coffee Cup" class="img-fluid rounded-4 shadow" style="max-height: 130px; object-fit: cover;" />
                    </div>
                </div>
            </div>

            <!-- Circular Category Icons Row (Image 2) -->
            <div class="d-flex overflow-auto gap-3 pb-3 mb-3 text-center no-scrollbar" id="cat-circle-row" style="white-space: nowrap;">
                <div class="cafe-circle-item active flex-shrink-0" onclick="filterByCategory('all', this)">
                    <div class="cafe-circle-icon"><i class="bi bi-cup-hot-fill"></i></div>
                    <div class="cafe-circle-label">All</div>
                </div>
                @foreach (var cat in Model.Categories)
                {
                    var iconClass = cat.Name.ToLower().Contains("coffee") ? "bi-cup-hot" :
                                    cat.Name.ToLower().Contains("food") || cat.Name.ToLower().Contains("sand") ? "bi-egg-fried" :
                                    cat.Name.ToLower().Contains("pastr") || cat.Name.ToLower().Contains("dessert") ? "bi-cake2" : "bi-tropical-storm";
                    
                    <div class="cafe-circle-item flex-shrink-0" onclick="filterByCategory('@cat.Id', this)">
                        <div class="cafe-circle-icon"><i class="bi @iconClass"></i></div>
                        <div class="cafe-circle-label">@cat.Name</div>
                    </div>
                }
            </div>

            <!-- Category Pills Bar (Image 1) -->
            <div class="d-flex overflow-auto gap-2 mb-4 pb-1 no-scrollbar" id="cat-pills-row" style="white-space: nowrap;">
                <button class="cafe-cat-pill active" onclick="filterByCategory('all', this)">All Menu</button>
                @foreach (var cat in Model.Categories)
                {
                    <button class="cafe-cat-pill" onclick="filterByCategory('@cat.Id', this)">@cat.Name</button>
                }
            </div>

            <!-- Products Section Title -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0" id="sectionTitle">Menu Items</h4>
                <small class="text-muted" id="itemCountText">Showing all items</small>
            </div>

            <!-- Products Grid (Image 1 & 2 Cards) -->
            <div class="row g-3 g-md-4" id="productsGrid">
                @foreach (var cat in Model.Categories)
                {
                    @foreach (var item in cat.MenuItems)
                    {
                        var badgeType = item.Name.Contains("Cappuccino") || item.Name.Contains("Pizza") ? "BESTSELLER" :
                                        item.Name.Contains("Muffin") || item.Name.Contains("V60") ? "CHEF'S PICK" : "POPULAR";
                        var badgeClass = badgeType == "BESTSELLER" ? "cafe-badge-bestseller" :
                                         badgeType == "CHEF'S PICK" ? "cafe-badge-chef" : "cafe-badge-popular";
                        var rating = (4.6 + (item.Name.Length % 4) * 0.1).ToString("0.0");
                        var ratingCount = (500 + (item.Name.Length * 47));
                        var hasCustomizations = item.Customizations.Any();

                        <div class="col-12 col-sm-6 col-xl-4 product-item-wrapper" 
                             data-cat-id="@cat.Id" 
                             data-name="@item.Name.ToLower()" 
                             data-is-veg="@item.IsVeg.ToString().ToLower()">
                            
                            <div class="cafe-product-card">
                                <!-- Card Image -->
                                <div class="cafe-card-img-wrap mb-3">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1509785307050-d4066910ec1e?auto=format&fit=crop&w=600&q=80" : item.ImageUrl)" 
                                         alt="@item.Name" class="cafe-card-img" loading="lazy" />
                                    <span class="cafe-badge @badgeClass">@badgeType</span>
                                </div>

                                <!-- Card Details -->
                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                    <h6 class="fw-bold mb-0 text-truncate me-2" style="font-size: 16px;">@item.Name</h6>
                                    <span class="fw-bold text-dark fs-6" style="color: var(--cafe-primary) !important;">
                                        ₹@item.Price.ToString("0.00")
                                    </span>
                                </div>

                                <!-- Rating & Dietary Tag -->
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span class="text-warning small fw-bold">★ @rating</span>
                                    <span class="text-muted small">(@ratingCount+)</span>
                                    @if (item.IsVeg)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success ms-auto" style="font-size: 10px;">VEG</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger ms-auto" style="font-size: 10px;">NON-VEG</span>
                                    }
                                </div>

                                <p class="text-muted small mb-3 flex-grow-1" style="font-size: 13px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    @item.Description
                                </p>

                                <!-- Customization Badges / Hints -->
                                @if (hasCustomizations)
                                {
                                    <div class="d-flex gap-1 mb-3 overflow-hidden text-truncate" style="cursor: pointer;" onclick="openCustomizationModal('@item.Id')">
                                        <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">
                                            <i class="bi bi-sliders me-1"></i> @item.Customizations.Count Options / Sizes
                                        </span>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-3">
                                        <span class="cafe-size-pill active">Standard</span>
                                    </div>
                                }

                                <!-- Bottom Action Controls -->
                                <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top border-light">
                                    @if (hasCustomizations)
                                    {
                                        <button class="btn btn-cafe-outline btn-sm w-100 fw-bold" onclick="openCustomizationModal('@item.Id')">
                                            <i class="bi bi-plus-lg me-1"></i> Customize &amp; Add
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="cafe-stepper">
                                            <button class="cafe-stepper-btn" onclick="updateQty('@item.Id', -1)">-</button>
                                            <span class="cafe-stepper-val" id="qty-val-@item.Id">1</span>
                                            <button class="cafe-stepper-btn" onclick="updateQty('@item.Id', 1)">+</button>
                                        </div>
                                        <button class="btn btn-cafe-primary btn-sm px-3" onclick="addDirectToCart('@item.Id')">
                                            Add to Cart
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </main>

        <!-- Right Side Cart Summary Panel (Desktop / Tablet - Image 1) -->
        <aside class="col-lg-3 col-xl-3 d-none d-lg-block">
            <div class="cafe-cart-panel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0">My Cart &amp; Orders</h5>
                    <span class="badge bg-dark-subtle text-dark border">
                        <i class="bi bi-geo-alt me-1"></i>@Model.Table.TableNumber
                    </span>
                </div>

                <!-- Active Placed Orders Live Tracking (Desktop) -->
                <div id="desktopActiveOrdersContainer" class="mb-3">
                    <!-- Dynamic live tracking cards populated here -->
                </div>

                <!-- Dusra Order / Draft Cart Section (Desktop) -->
                <div id="desktopDusraOrderSection">
                    <div id="desktopDusraOrderHeader" class="d-none">
                        <div class="d-flex align-items-center justify-content-between my-2 pt-2 border-top">
                            <h6 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-plus-circle-fill me-1"></i> Dusra Order Dein
                            </h6>
                            <span class="badge bg-warning-subtle text-dark border">Round 2+</span>
                        </div>
                        <p class="text-muted small mb-2" style="font-size: 11px;">Add more items for table @Model.Table.TableNumber</p>
                    </div>

                    <!-- Service Switcher (Delivery / Dine in / Take away) -->
                    <div class="d-flex gap-1 mb-3 bg-light p-1 rounded-pill">
                        <span class="cafe-service-pill"><i class="bi bi-truck me-1"></i>Delivery</span>
                        <span class="cafe-service-pill active"><i class="bi bi-cup-straw me-1"></i>Dine in</span>
                        <span class="cafe-service-pill"><i class="bi bi-bag me-1"></i>Take away</span>
                    </div>

                    <!-- Desktop Cart Items List -->
                    <div id="desktopCartItems" class="mb-3" style="max-height: 240px; overflow-y: auto;">
                        <div class="text-center text-muted py-4 small">
                            <i class="bi bi-cup display-6 d-block mb-2 text-black-50"></i>
                            Your order is empty.<br />Click "+ Add to Cart" to start.
                        </div>
                    </div>

                    <!-- Notes & WhatsApp input -->
                    <div class="mb-3">
                        <input type="text" id="desktopNotes" class="form-control form-control-sm rounded-pill mb-2" placeholder="Cooking instructions (e.g. less ice)..." />
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-whatsapp text-success"></i></span>
                            <input type="tel" id="desktopCustomerPhone" class="form-control" placeholder="WhatsApp for updates (Optional)" maxlength="10" />
                        </div>
                    </div>

                    <!-- Bill breakdown -->
                    <div class="pt-3 border-top">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Price</span>
                            <span>₹<span id="dtSubTotal">0.00</span></span>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-2">
                            <span>Taxes (@Model.Restaurant.DefaultTaxRate%)</span>
                            <span>₹<span id="dtTax">0.00</span></span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-5 border-top pt-2 mb-3">
                            <span id="dtTotalLabel">Grand total</span>
                            <span style="color: var(--cafe-primary);">₹<span id="dtGrandTotal">0.00</span></span>
                        </div>

                        <button class="btn btn-cafe-primary w-100 py-3 fw-bold" id="btnDesktopPlaceOrder" onclick="placeOrder('desktopNotes')" disabled>
                            Place an order
                        </button>
                    </div>
                </div>
            </div>
        </aside>

    </div>
</div>

<!-- Customization Popup Modal -->
<div class="modal fade" id="customizationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-3" style="background-color: #241812;">
                <h5 class="modal-title fw-bold" id="customModalTitle">
                    <i class="bi bi-sliders me-2" style="color: var(--cafe-primary);"></i>Customize Your Order
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <img id="customModalImg" src="" class="rounded-3 me-3" style="width: 64px; height: 64px; object-fit: cover;" />
                    <div>
                        <h5 class="fw-bold mb-1" id="customModalItemName">Item Name</h5>
                        <div class="text-muted small">Base price: ₹<span id="customModalBasePrice">0.00</span></div>
                    </div>
                </div>

                <hr class="my-3" />

                <h6 class="fw-bold small text-uppercase text-muted mb-2">Available Add-ons &amp; Sizes:</h6>
                <div id="customModalOptionsList" class="mb-4">
                    <!-- Populated dynamically -->
                </div>

                <div class="d-flex justify-content-between align-items-center p-3 rounded-4 mb-3" style="background-color: var(--cafe-primary-light);">
                    <span class="fw-bold">Item Price (with Options):</span>
                    <span class="fs-4 fw-bold" style="color: var(--cafe-primary);">₹<span id="customModalCalculatedPrice">0.00</span></span>
                </div>

                <button type="button" class="btn btn-cafe-primary w-100 py-3 fw-bold" id="btnCustomAddCart" onclick="confirmCustomizationAndAdd()">
                    Add to Cart
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Bottom Docked Cart Bar (Image 2) -->
<div id="mobileCartBar" class="d-lg-none fixed-bottom bg-white border-top shadow-lg p-3 d-none" style="z-index: 1040;">
    <div class="container d-flex justify-content-between align-items-center">
        <div id="mobileBarContent">
            <span class="badge rounded-pill bg-danger me-2" id="mobileCartBadge">0</span>
            <span class="fw-bold fs-6">₹<span id="mobileCartTotalText">0.00</span></span>
            <small class="text-muted d-block" id="mobileCartSubtext" style="font-size: 11px;">(incl. @Model.Restaurant.DefaultTaxRate% tax)</small>
        </div>
        <button class="btn btn-cafe-primary px-3 fw-bold d-flex align-items-center gap-1" id="btnMobileBarAction" onclick="openCartModal()">
            <span id="mobileBarBtnText">View Cart</span> <i class="bi bi-chevron-right ms-1"></i>
        </button>
    </div>
</div>

<!-- Cart Offcanvas Modal (for Mobile or Quick Review) -->
<div class="modal fade" id="cartModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header text-white p-3" style="background-color: #241812;">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-cup-hot me-2" style="color: var(--cafe-primary);"></i>Table @Model.Table.TableNumber &mdash; Cart &amp; Status
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 p-sm-4">
                <!-- Active Placed Orders Live Tracking (Modal) -->
                <div id="modalActiveOrdersContainer" class="mb-3">
                    <!-- Populated dynamically -->
                </div>

                <!-- Dusra Order / Draft Cart Section (Modal) -->
                <div id="modalDusraOrderSection">
                    <div id="modalDusraOrderHeader" class="d-none">
                        <div class="d-flex align-items-center justify-content-between my-2 pt-2 border-top">
                            <h6 class="fw-bold mb-0 text-primary">
                                <i class="bi bi-plus-circle-fill me-1"></i> Dusra Order Dein (Add More Items)
                            </h6>
                            <span class="badge bg-warning-subtle text-dark border">Round 2+</span>
                        </div>
                        <p class="text-muted small mb-3" style="font-size: 12px;">Add more items to table @Model.Table.TableNumber</p>
                    </div>

                    <div id="modalCartItems" class="mb-3">
                        <!-- Populated dynamically -->
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted">Special instructions for the barista &amp; chef:</label>
                        <textarea id="modalNotes" class="form-control rounded-3 mb-2" rows="2" placeholder="e.g. Extra hot, separate bag..."></textarea>
                        <label class="form-label small fw-semibold text-muted d-flex align-items-center gap-1 mb-1">
                            <i class="bi bi-whatsapp text-success"></i> WhatsApp Number for Live Updates (Optional):
                        </label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light text-muted">+91</span>
                            <input type="tel" id="modalCustomerPhone" class="form-control" placeholder="10-digit mobile number" maxlength="10" />
                        </div>
                    </div>

                    <div class="bg-light p-3 rounded-4">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Items Subtotal</span>
                            <span>₹<span id="modalSubTotal">0.00</span></span>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mb-2">
                            <span>GST / Taxes (@Model.Restaurant.DefaultTaxRate%)</span>
                            <span>₹<span id="modalTax">0.00</span></span>
                        </div>
                        <div class="d-flex justify-content-between fw-bold fs-4 border-top pt-2">
                            <span id="modalTotalLabel">Grand Total</span>
                            <span style="color: var(--cafe-primary);">₹<span id="modalGrandTotal">0.00</span></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light p-3">
                <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">Add More Items</button>
                <button type="button" class="btn btn-cafe-primary fw-bold px-4" id="btnModalPlaceOrder" onclick="placeOrder('modalNotes')">
                    Confirm & Send to Kitchen
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Call Waiter Modal -->
<div class="modal fade" id="callWaiterModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-bell-fill text-warning me-2"></i>Call Waiter / Assistance
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">Table <strong>@Model.Table.TableNumber</strong> &mdash; How can our team assist you?</p>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <button type="button" class="btn btn-outline-dark w-100 py-3 rounded-3 text-start d-flex align-items-center gap-2 service-opt active" onclick="selectServiceType('Assistance', this)">
                            <span class="fs-4">🛎️</span>
                            <div>
                                <div class="fw-bold small">Call Waiter</div>
                                <small class="text-muted" style="font-size: 11px;">General help</small>
                            </div>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-outline-dark w-100 py-3 rounded-3 text-start d-flex align-items-center gap-2 service-opt" onclick="selectServiceType('Water', this)">
                            <span class="fs-4">💧</span>
                            <div>
                                <div class="fw-bold small">Drinking Water</div>
                                <small class="text-muted" style="font-size: 11px;">Refill glasses</small>
                            </div>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-outline-dark w-100 py-3 rounded-3 text-start d-flex align-items-center gap-2 service-opt" onclick="selectServiceType('Cutlery', this)">
                            <span class="fs-4">🍴</span>
                            <div>
                                <div class="fw-bold small">Cutlery &amp; Napkins</div>
                                <small class="text-muted" style="font-size: 11px;">Spoons / tissues</small>
                            </div>
                        </button>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-outline-dark w-100 py-3 rounded-3 text-start d-flex align-items-center gap-2 service-opt" onclick="selectServiceType('Bill', this)">
                            <span class="fs-4">💳</span>
                            <div>
                                <div class="fw-bold small">Request Bill</div>
                                <small class="text-muted" style="font-size: 11px;">Get total check</small>
                            </div>
                        </button>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted">Special Request (Optional)</label>
                    <input type="text" id="serviceRequestNotes" class="form-control rounded-3" placeholder="e.g. Extra sugar, clean table..." />
                </div>
                <div id="serviceCallAlert" class="alert alert-success d-none rounded-3 py-2 px-3 small">
                    <i class="bi bi-check-circle me-1"></i> Waiter has been notified! A staff member is on the way.
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-cafe-primary rounded-pill px-4" id="btnSendServiceCall" onclick="submitServiceCall()">
                    <i class="bi bi-send me-1"></i> Send Request
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    @{
        var catalogData = Model.Categories
            .SelectMany(c => c.MenuItems)
            .GroupBy(i => i.Id)
            .Select(g => g.First())
            .ToDictionary(
                item => item.Id.ToString(),
                item => new {
                    id = item.Id.ToString(),
                    name = item.Name,
                    price = item.Price,
                    img = string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1509785307050-d4066910ec1e?auto=format&fit=crop&w=600&q=80" : item.ImageUrl,
                    customizations = item.Customizations.Select(c => new {
                        id = c.Id.ToString(),
                        name = c.Name,
                        price = c.Price
                    }).ToList()
                }
            );
        var catalogJson = System.Text.Json.JsonSerializer.Serialize(catalogData);

        var activeOrdersData = Model.ActiveOrders.Select(o => new {
            orderId = o.Id,
            orderNumber = o.OrderNumber,
            orderToken = o.OrderToken,
            status = o.Status.ToString(),
            statusCode = (int)o.Status,
            totalAmount = o.TotalAmount,
            subTotal = o.SubTotal,
            taxAmount = o.TaxAmount,
            itemCount = o.OrderItems.Sum(i => i.Quantity),
            items = o.OrderItems.Select(i => new { name = i.ItemNameSnapshot, qty = i.Quantity, price = i.TotalPrice, custom = i.CustomizationSummary }).ToList(),
            createdAt = o.CreatedAtUtc.ToLocalTime().ToString("hh:mm tt"),
            isPaid = o.Status == MenuScan.Models.Entities.OrderStatus.Completed || (o.Bill != null && o.Bill.Status == MenuScan.Models.Entities.BillStatus.Paid),
            billNumber = o.Bill != null ? o.Bill.BillNumber : null
        }).ToList();
        var activeOrdersJson = System.Text.Json.JsonSerializer.Serialize(activeOrdersData);
    }
    <script>
        const restaurantSlug = "@Model.Restaurant.Slug";
        const tableToken = "@Model.Table.Token";
        const taxRate = @Model.Restaurant.DefaultTaxRate;
        
        // Build items data catalog safely serialized without quote/escaping vulnerabilities
        const menuCatalog = @Html.Raw(catalogJson);

        // Active orders for this table (passed initially and kept fresh via SignalR / AJAX)
        let currentActiveOrders = @Html.Raw(activeOrdersJson);

        let cart = {}; // key -> { menuItemId, name, price, qty, img, customizationIds, customizationSummary }
        let isVegOnly = false;
        let currentSearch = "";
        let currentCatId = "all";
        let activeCustomItemId = null;

        function getOrderStatusDetails(status, statusCode, isPaid) {
            let title = "Order Placed";
            let desc = "Received by kitchen & barista";
            let badgeClass = "bg-warning text-dark";
            let icon = '<i class="bi bi-hourglass-split"></i>';
            let pct = 25;
            let step = 0;

            if (statusCode === 1 || status === "Preparing" || status === "Accepted") {
                title = "Cooking in Kitchen";
                desc = "Barista & Chef preparing your order";
                badgeClass = "bg-info text-dark";
                icon = '<i class="bi bi-fire"></i>';
                pct = 50;
                step = 1;
            } else if (statusCode === 2 || status === "Ready") {
                title = "Ready to Serve";
                desc = "Dishes hot & ready to bring";
                badgeClass = "bg-primary text-white";
                icon = '<i class="bi bi-bell-fill"></i>';
                pct = 75;
                step = 2;
            } else if (statusCode === 3 || status === "Served") {
                title = "Food Served";
                desc = "Enjoy your meal & drinks!";
                badgeClass = "bg-success text-white";
                icon = '<i class="bi bi-check-circle-fill"></i>';
                pct = 100;
                step = 3;
            }

            if (isPaid || statusCode === 4 || status === "Completed") {
                title = "✓ Paid & Settled";
                desc = "Payment confirmed. Thank you!";
                badgeClass = "bg-dark text-white";
                icon = '<i class="bi bi-check2-circle text-success"></i>';
                pct = 100;
                step = 4;
            }

            return { title, desc, badgeClass, icon, pct, step };
        }

        function renderActiveOrdersUI(orders) {
            const dtContainer = document.getElementById('desktopActiveOrdersContainer');
            const modalContainer = document.getElementById('modalActiveOrdersContainer');
            const dtDusraHeader = document.getElementById('desktopDusraOrderHeader');
            const modalDusraHeader = document.getElementById('modalDusraOrderHeader');
            const dtTotalLabel = document.getElementById('dtTotalLabel');
            const modalTotalLabel = document.getElementById('modalTotalLabel');
            const btnDesktop = document.getElementById('btnDesktopPlaceOrder');
            const btnModal = document.getElementById('btnModalPlaceOrder');

            if (!orders || orders.length === 0) {
                if (dtContainer) dtContainer.innerHTML = '';
                if (modalContainer) modalContainer.innerHTML = '';
                if (dtDusraHeader) dtDusraHeader.classList.add('d-none');
                if (modalDusraHeader) modalDusraHeader.classList.add('d-none');
                if (dtTotalLabel) dtTotalLabel.innerText = 'Grand total';
                if (modalTotalLabel) modalTotalLabel.innerText = 'Grand Total';
                if (btnDesktop) btnDesktop.innerText = 'Place an order';
                if (btnModal) btnModal.innerText = 'Confirm & Send to Kitchen';
                return;
            }

            // Active orders exist! Switch into Multi-round / Dusra Order mode
            if (dtDusraHeader) dtDusraHeader.classList.remove('d-none');
            if (modalDusraHeader) modalDusraHeader.classList.remove('d-none');
            if (dtTotalLabel) dtTotalLabel.innerText = 'Dusra Order Total';
            if (modalTotalLabel) modalTotalLabel.innerText = 'Dusra Order Total';
            if (btnDesktop) btnDesktop.innerText = 'Send Dusra Order to Kitchen 🚀';
            if (btnModal) btnModal.innerText = 'Send Dusra Order to Kitchen 🚀';

            let html = `
                <div class="d-flex align-items-center justify-content-between mb-2 pb-1">
                    <h6 class="fw-bold mb-0 text-success" style="font-size: 14px;">
                        <i class="bi bi-clock-history me-1"></i> Active Placed Orders (${orders.length})
                    </h6>
                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1" style="font-size: 11px;">
                        <span class="spinner-grow spinner-grow-sm me-1" style="width: 7px; height: 7px;" role="status"></span> Live Status
                    </span>
                </div>
            `;

            orders.forEach((ord, index) => {
                const roundNum = orders.length - index;
                const st = getOrderStatusDetails(ord.status, ord.statusCode, ord.isPaid);

                let itemsHtml = '';
                (ord.items || []).forEach(it => {
                    itemsHtml += `
                        <div class="d-flex justify-content-between text-muted" style="font-size: 12px; line-height: 1.35;">
                            <span class="text-truncate me-2"><strong>${it.qty}x</strong> ${it.name}${it.custom ? ` <small class="text-secondary">(${it.custom})</small>` : ''}</span>
                            <span class="fw-semibold flex-shrink-0">₹${it.price.toFixed(2)}</span>
                        </div>
                    `;
                });

                html += `
                    <div class="card border rounded-3 mb-3 shadow-sm bg-white overflow-hidden">
                        <div class="card-header bg-dark text-white p-2 px-3 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-warning text-dark me-1 fw-bold" style="font-size: 10px;">Round #${roundNum}</span>
                                <strong style="font-size: 13px;">#${ord.orderNumber}</strong>
                            </div>
                            <small class="text-white-50" style="font-size: 11px;"><i class="bi bi-clock me-1"></i>${ord.createdAt}</small>
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge ${st.badgeClass} px-2 py-1 fs-6 d-flex align-items-center gap-1 shadow-sm">
                                    ${st.icon} <span>${st.title}</span>
                                </span>
                                <span class="fw-bold fs-6" style="color: var(--cafe-primary);">₹${ord.totalAmount.toFixed(2)}</span>
                            </div>

                            <div class="text-muted small mb-2" style="font-size: 12px;">${st.desc}</div>

                            <!-- Mini Stepper Bar -->
                            <div class="my-2">
                                <div class="progress" style="height: 6px; background-color: #ECECEC;">
                                    <div class="progress-bar ${st.step >= 3 ? 'bg-success' : 'bg-primary'}" role="progressbar" style="width: ${st.pct}%;"></div>
                                </div>
                                <div class="d-flex justify-content-between mt-1 text-muted" style="font-size: 10px;">
                                    <span class="${st.step >= 0 ? 'text-dark fw-bold' : ''}">Placed</span>
                                    <span class="${st.step >= 1 ? 'text-dark fw-bold' : ''}">Cooking</span>
                                    <span class="${st.step >= 2 ? 'text-dark fw-bold' : ''}">Ready</span>
                                    <span class="${st.step >= 3 ? 'text-dark fw-bold' : ''}">Served</span>
                                </div>
                            </div>

                            <!-- Items List -->
                            <div class="bg-light rounded-3 p-2 my-2 border">
                                <div class="fw-semibold text-dark mb-1" style="font-size: 11px;">
                                    Items ordered (${ord.itemCount}):
                                </div>
                                <div class="d-flex flex-column gap-1">
                                    ${itemsHtml}
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="mt-2 pt-1 border-top">
                                <a href="/order/track/${ord.orderToken}" class="btn btn-outline-dark btn-sm w-100 rounded-pill fw-semibold py-1 d-flex align-items-center justify-content-center gap-1" style="font-size: 12px;">
                                    <i class="bi bi-receipt text-primary"></i> ${ord.isPaid ? 'View Tax Receipt & Bill' : 'View Bill & Pay Online (UPI)'}
                                </a>
                            </div>
                        </div>
                    </div>
                `;
            });

            if (dtContainer) dtContainer.innerHTML = html;
            if (modalContainer) modalContainer.innerHTML = html;
        }

        async function loadActiveOrders() {
            try {
                const res = await fetch(`/api/table/active-orders?tableToken=${encodeURIComponent(tableToken)}&restaurantSlug=${encodeURIComponent(restaurantSlug)}`);
                if (res.ok) {
                    const orders = await res.json();
                    currentActiveOrders = orders;
                    renderActiveOrdersUI(currentActiveOrders);
                    updateCartUI();
                }
            } catch (err) {
                console.error("Failed to load active orders:", err);
            }
        }

        function showOrderSuccessNotification(orderNumber) {
            const banner = document.getElementById('orderSuccessBanner');
            const titleEl = document.getElementById('orderSuccessTitle');
            const descEl = document.getElementById('orderSuccessDesc');
            if (banner) {
                if (titleEl) titleEl.innerText = `Order #${orderNumber} Sent to Kitchen! 🚀`;
                if (descEl) descEl.innerText = `Your order is cooking and tracked right here in your cart. You can also place another round (Dusra Order) anytime!`;
                banner.classList.remove('d-none');
                banner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        function addDirectToCart(id) {
            const item = menuCatalog[id];
            if (!item) return;

            const stepperVal = parseInt(document.getElementById(`qty-val-${id}`)?.innerText || "1");
            const key = id;
            if (!cart[key]) {
                cart[key] = {
                    menuItemId: id,
                    name: item.name,
                    price: item.price,
                    qty: stepperVal,
                    img: item.img,
                    customizationIds: [],
                    customizationSummary: ""
                };
            } else {
                cart[key].qty += stepperVal;
            }
            updateCartUI();
        }

        function openCustomizationModal(itemId) {
            activeCustomItemId = itemId;
            const item = menuCatalog[itemId];
            if (!item) return;

            const nameEl = document.getElementById('customModalItemName');
            if (nameEl) nameEl.innerText = item.name;
            const basePriceEl = document.getElementById('customModalBasePrice');
            if (basePriceEl) basePriceEl.innerText = item.price.toFixed(2);
            const imgEl = document.getElementById('customModalImg');
            if (imgEl) imgEl.src = item.img;
            const calcPriceEl = document.getElementById('customModalCalculatedPrice');
            if (calcPriceEl) calcPriceEl.innerText = item.price.toFixed(2);

            let optionsHtml = '';
            (item.customizations || []).forEach((c) => {
                const safeName = (c.name || '').replace(/"/g, '&quot;');
                optionsHtml += `
                    <div class="form-check p-3 mb-2 border rounded-3 d-flex align-items-center justify-content-between" style="background: #FAFAFA;">
                        <div>
                            <input class="form-check-input me-2 custom-check-opt" type="checkbox" id="opt_${c.id}" value="${c.id}" data-price="${c.price}" data-name="${safeName}" onchange="recalcCustomModal()">
                            <label class="form-check-label fw-semibold" for="opt_${c.id}" style="cursor: pointer;">
                                ${c.name}
                            </label>
                        </div>
                        <span class="badge bg-light text-dark border">+₹${c.price.toFixed(2)}</span>
                    </div>
                `;
            });

            const optContainer = document.getElementById('customModalOptionsList');
            if (optContainer) optContainer.innerHTML = optionsHtml;

            const modalEl = document.getElementById('customizationModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        function recalcCustomModal() {
            if (!activeCustomItemId) return;
            const item = menuCatalog[activeCustomItemId];
            if (!item) return;
            let total = item.price;
            document.querySelectorAll('.custom-check-opt:checked').forEach(cb => {
                total += parseFloat(cb.getAttribute('data-price') || "0");
            });
            const calcPriceEl = document.getElementById('customModalCalculatedPrice');
            if (calcPriceEl) calcPriceEl.innerText = total.toFixed(2);
        }

        function confirmCustomizationAndAdd() {
            if (!activeCustomItemId) return;
            const item = menuCatalog[activeCustomItemId];
            if (!item) return;
            let lineUnitPrice = item.price;
            const selectedIds = [];
            const selectedNames = [];

            document.querySelectorAll('.custom-check-opt:checked').forEach(cb => {
                lineUnitPrice += parseFloat(cb.getAttribute('data-price') || "0");
                selectedIds.push(cb.value);
                selectedNames.push(cb.getAttribute('data-name') || "");
            });

            selectedIds.sort();
            const key = activeCustomItemId + (selectedIds.length > 0 ? ("_" + selectedIds.join("_")) : "");
            const summaryText = selectedNames.join(", ");

            if (!cart[key]) {
                cart[key] = {
                    menuItemId: activeCustomItemId,
                    name: item.name,
                    price: lineUnitPrice,
                    qty: 1,
                    img: item.img,
                    customizationIds: selectedIds,
                    customizationSummary: summaryText
                };
            } else {
                cart[key].qty++;
            }

            const modalEl = document.getElementById('customizationModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.hide();
            }
            updateCartUI();
        }

        function updateCartQty(key, change) {
            if (cart[key]) {
                cart[key].qty += change;
                if (cart[key].qty <= 0) {
                    delete cart[key];
                }
            }
            updateCartUI();
        }

        function updateQty(id, change) {
            const el = document.getElementById(`qty-val-${id}`);
            if (el) {
                let cur = parseInt(el.innerText);
                cur = Math.max(1, cur + change);
                el.innerText = cur;
            }
        }

        function updateCartUI() {
            let totalCount = 0;
            let subtotal = 0;

            for (const key in cart) {
                totalCount += cart[key].qty;
                subtotal += cart[key].price * cart[key].qty;
            }

            const tax = subtotal * (taxRate / 100);
            const grandTotal = subtotal + tax;

            // Badges (with defensive null checks)
            const setTxt = (id, val) => { const el = document.getElementById(id); if (el) el.innerText = val; };
            setTxt('sidebarCartCount', totalCount);
            setTxt('mobileHeaderCartCount', totalCount);

            // Floating bottom bar toggle & contents
            const mobileBar = document.getElementById('mobileCartBar');
            const mobileBadge = document.getElementById('mobileCartBadge');
            const mobileTotal = document.getElementById('mobileCartTotalText');
            const mobileSubtext = document.getElementById('mobileCartSubtext');
            const mobileBtnText = document.getElementById('mobileBarBtnText');

            if (mobileBar) {
                if (totalCount > 0) {
                    // Draft cart has items
                    mobileBar.classList.remove('d-none');
                    if (mobileBadge) {
                        mobileBadge.innerText = totalCount;
                        mobileBadge.className = "badge rounded-pill bg-danger me-2";
                    }
                    if (mobileTotal) mobileTotal.innerText = grandTotal.toFixed(2);
                    if (mobileSubtext) {
                        mobileSubtext.innerText = currentActiveOrders.length > 0 ? '(Dusra Order Draft)' : `(incl. ${taxRate}% tax)`;
                    }
                    if (mobileBtnText) {
                        mobileBtnText.innerText = currentActiveOrders.length > 0 ? 'Review Dusra Order' : 'View Cart';
                    }
                } else if (currentActiveOrders && currentActiveOrders.length > 0) {
                    // Draft cart is empty, but an active order is being tracked!
                    mobileBar.classList.remove('d-none');
                    const latest = currentActiveOrders[0];
                    const st = getOrderStatusDetails(latest.status, latest.statusCode, latest.isPaid);
                    if (mobileBadge) {
                        mobileBadge.innerText = `🔥 #${latest.orderNumber}`;
                        mobileBadge.className = `badge rounded-pill ${st.badgeClass} me-2`;
                    }
                    if (mobileTotal) mobileTotal.innerText = latest.totalAmount.toFixed(2);
                    if (mobileSubtext) {
                        mobileSubtext.innerText = `${st.title} • Tap to view & order more`;
                    }
                    if (mobileBtnText) {
                        mobileBtnText.innerText = 'Track & Order More';
                    }
                } else {
                    mobileBar.classList.add('d-none');
                }
            }

            // Summaries
            setTxt('dtSubTotal', subtotal.toFixed(2));
            setTxt('dtTax', tax.toFixed(2));
            setTxt('dtGrandTotal', grandTotal.toFixed(2));
            const btnDt = document.getElementById('btnDesktopPlaceOrder');
            if (btnDt) btnDt.disabled = totalCount === 0;

            setTxt('modalSubTotal', subtotal.toFixed(2));
            setTxt('modalTax', tax.toFixed(2));
            setTxt('modalGrandTotal', grandTotal.toFixed(2));
            const btnMod = document.getElementById('btnModalPlaceOrder');
            if (btnMod) btnMod.disabled = totalCount === 0;

            // Render Items HTML for Desktop Panel & Modal
            const desktopContainer = document.getElementById('desktopCartItems');
            const modalContainer = document.getElementById('modalCartItems');

            if (totalCount === 0) {
                if (currentActiveOrders && currentActiveOrders.length > 0) {
                    const emptyDusraPrompt = `
                        <div class="p-3 border rounded-3 bg-light text-center small text-muted">
                            <i class="bi bi-cart-plus fs-3 text-primary d-block mb-1"></i>
                            <span class="fw-bold text-dark d-block">Draft Cart is Empty</span>
                            <span>Click "+ Add to Cart" on any item above to send your next round (Dusra Order) to the kitchen.</span>
                        </div>`;
                    if (desktopContainer) desktopContainer.innerHTML = emptyDusraPrompt;
                    if (modalContainer) modalContainer.innerHTML = emptyDusraPrompt;
                } else {
                    if (desktopContainer) {
                        desktopContainer.innerHTML = `
                            <div class="text-center text-muted py-4 small">
                                <i class="bi bi-cup display-6 d-block mb-2 text-black-50"></i>
                                Your order is empty.<br />Click "+ Add to Cart" to start.
                            </div>`;
                    }
                    if (modalContainer) {
                        modalContainer.innerHTML = '<div class="text-center text-muted py-3">Your cart is empty.</div>';
                    }
                }
            } else {
                let html = '';
                for (const key in cart) {
                    const it = cart[key];
                    html += `
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <div class="d-flex align-items-center me-2 text-truncate">
                                <img src="${it.img}" class="rounded-3 me-2" style="width: 44px; height: 44px; object-fit: cover;" />
                                <div class="text-truncate">
                                    <h6 class="mb-0 fw-bold small text-truncate">${it.name}</h6>
                                    ${it.customizationSummary ? `<div class="small text-muted" style="font-size: 11px;">${it.customizationSummary}</div>` : ''}
                                    <span class="small fw-semibold" style="color: var(--cafe-primary);">₹${it.price.toFixed(2)}</span>
                                </div>
                            </div>
                            <div class="cafe-stepper">
                                <button class="cafe-stepper-btn" onclick="updateCartQty('${key}', -1)">-</button>
                                <span class="cafe-stepper-val">${it.qty}</span>
                                <button class="cafe-stepper-btn" onclick="updateCartQty('${key}', 1)">+</button>
                            </div>
                        </div>
                    `;
                }
                if (desktopContainer) desktopContainer.innerHTML = html;
                if (modalContainer) modalContainer.innerHTML = html;
            }
        }

        function filterByCategory(catId, element) {
            currentCatId = catId;
            document.querySelectorAll('.cafe-cat-pill, .cafe-circle-item').forEach(el => el.classList.remove('active'));
            element.classList.add('active');
            applyFilters();
        }

        function handleSearch(val) {
            currentSearch = val.toLowerCase().trim();
            applyFilters();
        }

        function toggleVegFilter(btn) {
            isVegOnly = !isVegOnly;
            btn.classList.toggle('active', isVegOnly);
            btn.classList.toggle('btn-success', isVegOnly);
            btn.classList.toggle('btn-cafe-outline', !isVegOnly);
            applyFilters();
        }

        function applyFilters() {
            let visibleCount = 0;
            document.querySelectorAll('.product-item-wrapper').forEach(card => {
                const itemCat = card.getAttribute('data-cat-id');
                const itemName = card.getAttribute('data-name');
                const isVeg = card.getAttribute('data-is-veg') === 'true';

                const matchesCat = currentCatId === 'all' || itemCat === currentCatId;
                const matchesSearch = !currentSearch || itemName.includes(currentSearch);
                const matchesVeg = !isVegOnly || isVeg;

                if (matchesCat && matchesSearch && matchesVeg) {
                    card.classList.remove('d-none');
                    visibleCount++;
                } else {
                    card.classList.add('d-none');
                }
            });

            const cntEl = document.getElementById('itemCountText');
            if (cntEl) cntEl.innerText = `Showing ${visibleCount} items`;
        }

        function openCartModal() {
            const modalEl = document.getElementById('cartModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                const m = bootstrap.Modal.getOrCreateInstance(modalEl);
                m.show();
            }
        }

        async function placeOrder(notesInputId) {
            const items = [];
            for (const key in cart) {
                items.push({
                    menuItemId: cart[key].menuItemId,
                    quantity: cart[key].qty,
                    customizationIds: cart[key].customizationIds || [],
                    customizationSummary: cart[key].customizationSummary || ""
                });
            }

            if (items.length === 0) {
                alert("Your cart is empty! Please add items first.");
                return;
            }

            const notes = document.getElementById(notesInputId)?.value || "";
            const phoneInput = notesInputId === 'modalNotes'
                ? document.getElementById('modalCustomerPhone')
                : document.getElementById('desktopCustomerPhone');
            const phone = phoneInput ? phoneInput.value.trim() : "";

            const btn = document.getElementById('btnDesktopPlaceOrder');
            const modalBtn = document.getElementById('btnModalPlaceOrder');

            if (btn) btn.disabled = true;
            if (modalBtn) modalBtn.disabled = true;

            const idempotencyKey = (window.crypto && crypto.randomUUID) 
                ? crypto.randomUUID() 
                : ('idemp_' + Date.now() + '_' + Math.random().toString(36).substring(2, 11));

            try {
                const response = await fetch('/api/orders/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        restaurantSlug: restaurantSlug,
                        tableToken: tableToken,
                        idempotencyKey: idempotencyKey,
                        customerNotes: notes,
                        customerPhone: phone,
                        items: items
                    })
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    // Order submitted successfully!
                    // Clear the draft cart & notes
                    cart = {};
                    const dNotes = document.getElementById('desktopNotes');
                    if (dNotes) dNotes.value = '';
                    const mNotes = document.getElementById('modalNotes');
                    if (mNotes) mNotes.value = '';

                    // Reload active table orders live without reloading the whole page
                    await loadActiveOrders();
                    updateCartUI();

                    // Show success celebration alert
                    showOrderSuccessNotification(result.orderNumber);

                    // Re-enable place buttons
                    if (btn) btn.disabled = false;
                    if (modalBtn) modalBtn.disabled = false;
                } else {
                    alert(result.message || "Failed to place order.");
                    if (btn) btn.disabled = false;
                    if (modalBtn) modalBtn.disabled = false;
                }
            } catch (e) {
                console.error(e);
                alert("Network error.");
                if (btn) btn.disabled = false;
                if (modalBtn) modalBtn.disabled = false;
            }
        }

        let selectedServiceType = "Assistance";

        function openCallWaiterModal() {
            const modalEl = document.getElementById('callWaiterModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                const alertEl = document.getElementById('serviceCallAlert');
                if (alertEl) alertEl.classList.add('d-none');
                const btnSend = document.getElementById('btnSendServiceCall');
                if (btnSend) btnSend.disabled = false;
                const m = bootstrap.Modal.getOrCreateInstance(modalEl);
                m.show();
            }
        }

        function selectServiceType(type, btnElement) {
            selectedServiceType = type;
            document.querySelectorAll('.service-opt').forEach(b => {
                b.classList.remove('active', 'border-warning', 'bg-warning-subtle');
            });
            btnElement.classList.add('active', 'border-warning', 'bg-warning-subtle');
        }

        async function submitServiceCall() {
            const btn = document.getElementById('btnSendServiceCall');
            const alertBox = document.getElementById('serviceCallAlert');
            const notes = document.getElementById('serviceRequestNotes')?.value || "";

            if (btn) btn.disabled = true;
            try {
                const response = await fetch('/api/table/call-waiter', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        restaurantSlug: restaurantSlug,
                        tableToken: tableToken,
                        requestType: selectedServiceType,
                        notes: notes
                    })
                });

                const data = await response.json();
                if (response.ok && data.success) {
                    if (alertBox) alertBox.classList.remove('d-none');
                    setTimeout(() => {
                        const modalEl = document.getElementById('callWaiterModal');
                        if (modalEl && typeof bootstrap !== 'undefined') {
                            bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                        }
                    }, 2000);
                } else {
                    alert(data.message || "Failed to notify staff.");
                    if (btn) btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert("Network error.");
                if (btn) btn.disabled = false;
            }
        }

        // Initialize SignalR Real-time Listener for instant status updates
        try {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/order")
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .build();

            connection.on("ReceiveOrderStatusUpdate", async (orderNumber, newStatus, tableNumber) => {
                console.log("SignalR Order Status Update:", orderNumber, newStatus, tableNumber);
                await loadActiveOrders();
            });

            connection.on("ReceivePaymentSettled", async (data) => {
                console.log("SignalR Payment Settled:", data);
                await loadActiveOrders();
            });

            connection.on("ReceiveNewOrder", async (data) => {
                console.log("SignalR New Order:", data);
                await loadActiveOrders();
            });

            connection.start().then(async () => {
                console.log("SignalR Connected to OrderHub");
                await connection.invoke("JoinRestaurantGroup", "@Model.Restaurant.Id");
            }).catch(err => console.warn("SignalR connection notice:", err));
        } catch (e) {
            console.warn("SignalR initialization notice:", e);
        }

        // Initial render on page load
        renderActiveOrdersUI(currentActiveOrders);
        updateCartUI();
    </script>
}
