@model List<MenuScan.Models.Entities.DiningTable>
@{
    ViewData["Title"] = "Dining Tables & QR Codes";
    Layout = "_Layout";
    var restaurant = (MenuScan.Models.Entities.Restaurant)ViewBag.Restaurant;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-0">Dining Tables & QR Codes</h3>
            <p class="text-muted mb-0">@restaurant.Name - Table Management</p>
        </div>
        <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#addTableModal">
            <i class="bi bi-plus-circle me-1"></i> Add New Table
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tables Grid -->
    <div class="row g-4">
        @foreach (var table in Model)
        {
            <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <div class="card-body p-4 text-center">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge @(table.IsActive ? "bg-success" : "bg-secondary")">
                                @(table.IsActive ? "Active" : "Inactive")
                            </span>
                            <span class="text-muted small"><i class="bi bi-people"></i> @table.Capacity Seats</span>
                        </div>
                        
                        <div class="my-3">
                            <i class="bi bi-grid-3x3-gap display-4 text-primary"></i>
                            <h4 class="fw-bold mt-2">@table.TableNumber</h4>
                            <code class="small text-muted">Token: @table.Token</code>
                        </div>

                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-dark btn-sm fw-semibold" onclick="showQrModal('@table.Id')">
                                <i class="bi bi-qr-code me-1"></i> View & Print QR
                            </button>
                            <a href="/r/@restaurant.Slug/t/@table.Token" target="_blank" class="btn btn-light btn-sm text-primary">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Test Customer View
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Add Table Modal -->
<div class="modal fade" id="addTableModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="AddTable" method="post">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">Add New Dining Table</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Table Name / Number</label>
                        <input type="text" name="tableNumber" class="form-control" placeholder="e.g. Table 5 or Patio 1" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Seating Capacity</label>
                        <input type="number" name="capacity" class="form-control" value="4" min="1" max="20" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">Create Table</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View QR Code Modal -->
<div class="modal fade" id="qrModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow text-center">
            <div class="modal-header bg-white border-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pb-4 pt-0" id="qrPrintArea">
                <div class="border p-4 rounded-3 shadow-sm bg-white d-inline-block w-100">
                    <h4 class="fw-bold mb-1" id="qrModalRestName">@restaurant.Name</h4>
                    <span class="badge bg-danger fs-6 mb-3" id="qrModalTableNumber">Table</span>

                    <div class="my-3">
                        <img id="qrImageElement" src="" alt="Table QR Code" class="img-fluid rounded border p-2" style="max-width: 240px;" />
                    </div>

                    <p class="fw-bold text-dark mb-1">SCAN TO ORDER & PAY</p>
                    <small class="text-muted d-block mb-2">No app download needed</small>
                    <code class="small text-truncate d-block" id="qrModalUrlText"></code>
                </div>
            </div>
            <div class="modal-footer bg-light justify-content-center">
                <button type="button" class="btn btn-primary fw-bold" onclick="printQrCard()">
                    <i class="bi bi-printer me-1"></i> Print Table Stand
                </button>
                <a href="#" id="qrDirectLink" target="_blank" class="btn btn-outline-secondary">
                    Open Menu Link
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let qrModalInstance;

        async function showQrModal(tableId) {
            try {
                const response = await fetch(`/Admin/GetTableQr?id=${tableId}`);
                const data = await response.json();

                document.getElementById('qrModalRestName').innerText = data.restaurantName;
                document.getElementById('qrModalTableNumber').innerText = data.tableNumber;
                document.getElementById('qrImageElement').src = data.qrDataUri;
                document.getElementById('qrModalUrlText').innerText = data.customerUrl;
                document.getElementById('qrDirectLink').href = data.customerUrl;

                qrModalInstance = new bootstrap.Modal(document.getElementById('qrModal'));
                qrModalInstance.show();
            } catch (e) {
                console.error(e);
                alert("Failed to load QR code.");
            }
        }

        function printQrCard() {
            const printContent = document.getElementById('qrPrintArea').innerHTML;
            const win = window.open('', '_blank');
            win.document.write(`
                <html>
                <head>
                    <title>Table Stand QR</title>
                    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
                    <style>
                        body { text-align: center; padding: 40px; }
                        img { max-width: 300px; }
                    </style>
                </head>
                <body onload="window.print(); window.close();">
                    ${printContent}
                </body>
                </html>
            `);
            win.document.close();
        }
    </script>
}
