@model List<MenuScan.Controllers.StaffUserDto>
@{
    ViewData["Title"] = "Staff & Role Management";
    Layout = "_Layout";
    var restaurant = (MenuScan.Models.Entities.Restaurant)ViewBag.Restaurant;
    var cashierCount = Model.Count(u => u.Role == MenuScan.Models.Entities.AppRoles.Cashier);
    var kitchenCount = Model.Count(u => u.Role == MenuScan.Models.Entities.AppRoles.KitchenStaff);
    var adminCount = Model.Count(u => u.Role == MenuScan.Models.Entities.AppRoles.RestaurantAdmin);
}

<div class="container-fluid py-4 px-3 px-lg-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="fs-4">👥</span>
                <h3 class="fw-bold mb-0" style="letter-spacing: -0.5px;">Staff &amp; Role Management</h3>
                <span class="badge bg-dark rounded-pill px-3 py-1">@restaurant.Name</span>
            </div>
            <p class="text-muted small mb-0">Register and manage kitchen chefs, cashiers, and store managers for this branch</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-cafe-primary fw-bold rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                <i class="bi bi-person-plus-fill me-1"></i> Register New Staff
            </button>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Total Team</div>
                        <h3 class="fw-bold mb-0 mt-1">@Model.Count</h3>
                        <small class="text-success"><i class="bi bi-check-circle me-1"></i>@Model.Count(s => s.IsActive) Active</small>
                    </div>
                    <div class="p-3 rounded-circle bg-light text-primary">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Cashiers / POS</div>
                        <h3 class="fw-bold mb-0 mt-1 text-success">@cashierCount</h3>
                        <small class="text-muted">Billing &amp; Payments</small>
                    </div>
                    <div class="p-3 rounded-circle bg-success-subtle text-success">
                        <i class="bi bi-credit-card-2-front-fill fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Kitchen Staff</div>
                        <h3 class="fw-bold mb-0 mt-1 text-warning-emphasis">@kitchenCount</h3>
                        <small class="text-muted">Chefs &amp; Baristas</small>
                    </div>
                    <div class="p-3 rounded-circle bg-warning-subtle text-warning">
                        <i class="bi bi-fire fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Store Managers</div>
                        <h3 class="fw-bold mb-0 mt-1 text-primary">@adminCount</h3>
                        <small class="text-muted">Branch Admins</small>
                    </div>
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Staff Directory Card -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white py-3 px-4 d-flex justify-content-between align-items-center border-bottom">
            <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-primary"></i> Team Member Directory
            </h5>
            <span class="badge bg-light text-dark border rounded-pill px-3 py-2">
                @Model.Count Active Accounts
            </span>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-person-slash display-5 d-block mb-3 text-muted"></i>
                    <h5 class="fw-bold">No Staff Members Registered Yet</h5>
                    <p class="small text-muted mb-3">Register your cashiers and kitchen chefs using the button above.</p>
                    <button class="btn btn-cafe-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addStaffModal">
                        <i class="bi bi-person-plus-fill me-1"></i> Register First Staff Member
                    </button>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th>Staff Member</th>
                                <th>Assigned Role</th>
                                <th>Role Capabilities &amp; Access</th>
                                <th>Status</th>
                                <th>Joined</th>
                                <th class="text-center" style="width: 140px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                var isCurrentUser = user.Email.Equals(User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 42px; height: 42px; background-color: var(--cafe-primary);">
                                                @(string.IsNullOrEmpty(user.FullName) ? "U" : user.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">
                                                    @user.FullName
                                                    @if (isCurrentUser)
                                                    {
                                                        <span class="badge bg-info text-dark rounded-pill ms-1" style="font-size: 0.7rem;">You</span>
                                                    }
                                                </div>
                                                <small class="text-muted font-monospace">@user.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (user.Role == MenuScan.Models.Entities.AppRoles.Cashier)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-credit-card-2-front-fill me-1"></i> Cashier
                                            </span>
                                        }
                                        else if (user.Role == MenuScan.Models.Entities.AppRoles.KitchenStaff)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-fire me-1"></i> Kitchen Staff
                                            </span>
                                        }
                                        else if (user.Role == MenuScan.Models.Entities.AppRoles.RestaurantAdmin)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary px-3 py-2 rounded-pill fw-bold">
                                                <i class="bi bi-shield-check me-1"></i> Store Manager
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                                @user.Role
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            @if (user.Role == MenuScan.Models.Entities.AppRoles.Cashier)
                                            {
                                                <span><i class="bi bi-check2 text-success me-1"></i>Billing POS &bull; Settle UPI/Cash &bull; Day-End WhatsApp Summary</span>
                                            }
                                            else if (user.Role == MenuScan.Models.Entities.AppRoles.KitchenStaff)
                                            {
                                                <span><i class="bi bi-check2 text-success me-1"></i>Live KDS Screen &bull; Mark Food Cooking &bull; Runner Call</span>
                                            }
                                            else if (user.Role == MenuScan.Models.Entities.AppRoles.RestaurantAdmin)
                                            {
                                                <span><i class="bi bi-check2 text-success me-1"></i>Full Store Management &bull; Menu &bull; Tables &bull; Reports &bull; Staff</span>
                                            }
                                            else
                                            {
                                                <span>Platform Access</span>
                                            }
                                        </small>
                                    </td>
                                    <td>
                                        <form asp-action="ToggleStaffStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@user.Id" />
                                            @if (user.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-semibold" @(isCurrentUser ? "disabled" : "") title="Click to Deactivate">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Active
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1 fw-semibold" @(isCurrentUser ? "disabled" : "") title="Click to Activate">
                                                    <i class="bi bi-dash-circle me-1"></i> Inactive
                                                </button>
                                            }
                                        </form>
                                    </td>
                                    <td>
                                        <small class="text-muted">@user.CreatedAtUtc.ToString("dd MMM yyyy")</small>
                                    </td>
                                    <td class="text-center">
                                        @if (!isCurrentUser)
                                        {
                                            <form asp-action="DeleteStaff" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete staff account \'@user.FullName\'?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Delete Staff Account">
                                                    <i class="bi bi-trash3 me-1"></i> Remove
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Active Session</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- ADD STAFF MODAL                            -->
<!-- ========================================== -->
<div class="modal fade" id="addStaffModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="AddStaff" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark text-white p-3 px-4">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-person-plus-fill me-2 text-warning"></i>Register New Staff Account
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-light border rounded-3 small text-muted mb-4">
                        <i class="bi bi-info-circle-fill text-primary me-1"></i>
                        Registering for: <strong class="text-dark">@restaurant.Name</strong>. The staff member will be granted portal access restricted to this store.
                    </div>

                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Staff Member Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="fullName" class="form-control rounded-3" placeholder="e.g. Ramesh Patel" required />
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Staff Login Email <span class="text-danger">*</span></label>
                            <input type="email" name="email" class="form-control rounded-3" placeholder="e.g. cashier@spicecafe.com" required />
                        </div>

                        <!-- Role Selector -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Select Store Role <span class="text-danger">*</span></label>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="card h-100 border rounded-3 p-3 text-center cursor-pointer role-card" for="roleCashier" style="cursor: pointer;">
                                        <input type="radio" name="role" id="roleCashier" value="Cashier" class="form-check-input mb-2 mx-auto" checked />
                                        <i class="bi bi-credit-card-2-front fs-3 text-success d-block mb-1"></i>
                                        <strong class="d-block text-dark">Cashier</strong>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">POS Billing, Payment QR verification, Soundbox, Day-End Reports</small>
                                    </label>
                                </div>

                                <div class="col-md-4">
                                    <label class="card h-100 border rounded-3 p-3 text-center cursor-pointer role-card" for="roleKitchen" style="cursor: pointer;">
                                        <input type="radio" name="role" id="roleKitchen" value="KitchenStaff" class="form-check-input mb-2 mx-auto" />
                                        <i class="bi bi-fire fs-3 text-warning d-block mb-1"></i>
                                        <strong class="d-block text-dark">Kitchen Staff</strong>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">Live KDS Screen, Cooking timer, Mark food ready, Runner alerts</small>
                                    </label>
                                </div>

                                <div class="col-md-4">
                                    <label class="card h-100 border rounded-3 p-3 text-center cursor-pointer role-card" for="roleAdmin" style="cursor: pointer;">
                                        <input type="radio" name="role" id="roleAdmin" value="RestaurantAdmin" class="form-check-input mb-2 mx-auto" />
                                        <i class="bi bi-shield-check fs-3 text-primary d-block mb-1"></i>
                                        <strong class="d-block text-dark">Co-Manager</strong>
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">Full access to Menu, Tables, Feedback, Floor Plan, and Staff</small>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- Initial Password -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Login Password <span class="text-danger">*</span></label>
                            <input type="password" name="password" id="staffPasswordInput" class="form-control rounded-3" placeholder="Minimum 6 characters (e.g. Staff@123)" required minlength="6" />
                            <div class="form-text small text-muted">
                                Provide this email and password to the staff member so they can log in via <a href="/Account/Login" target="_blank">Staff Portal</a>.
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-cafe-primary fw-bold rounded-pill px-5 shadow-sm">
                        <i class="bi bi-check-circle-fill me-1"></i> Create Staff Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
