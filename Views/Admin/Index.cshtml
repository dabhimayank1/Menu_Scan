@{
    ViewData["Title"] = "Restaurant Management";
    Layout = "_Layout";
    var restaurant = (MenuScan.Models.Entities.Restaurant)ViewBag.Restaurant;
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">@restaurant.Name</h2>
            <p class="text-muted mb-0">Management Portal | Multi-tenant SaaS</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Kitchen" asp-action="Index" class="btn btn-warning fw-bold text-dark">
                <i class="bi bi-fire me-1"></i> Kitchen KDS
            </a>
            <a asp-controller="Billing" asp-action="Index" class="btn btn-success fw-bold">
                <i class="bi bi-cash-stack me-1"></i> Cashier Billing
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase fw-semibold">Today's Revenue</small>
                        <h3 class="fw-bold text-success mb-0 mt-1">₹@(((decimal)ViewBag.TodayRevenue).ToString("0.00"))</h3>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle">
                        <i class="bi bi-currency-rupee fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-primary">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase fw-semibold">Today's Orders</small>
                        <h3 class="fw-bold text-primary mb-0 mt-1">@ViewBag.TodayOrders</h3>
                    </div>
                    <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                        <i class="bi bi-bag-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase fw-semibold">Dining Tables</small>
                        <h3 class="fw-bold text-info mb-0 mt-1">@ViewBag.TablesCount</h3>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-circle">
                        <i class="bi bi-grid-3x3-gap fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted text-uppercase fw-semibold">Active Menu Items</small>
                        <h3 class="fw-bold text-warning mb-0 mt-1">@ViewBag.ActiveItemsCount</h3>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle">
                        <i class="bi bi-egg-fried fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Modules Grid -->
    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="text-primary mb-3">
                        <i class="bi bi-qr-code-scan display-4"></i>
                    </div>
                    <h5 class="fw-bold">Dining Tables & QR Codes</h5>
                    <p class="text-muted small">Generate and print high-resolution QR codes for each table. Manage table numbers and seating capacities.</p>
                    <a asp-action="Tables" class="btn btn-outline-primary fw-semibold px-4">Manage Tables & QRs</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="text-danger mb-3">
                        <i class="bi bi-menu-button-wide-fill display-4"></i>
                    </div>
                    <h5 class="fw-bold">Digital Menu & Categories</h5>
                    <p class="text-muted small">Update food categories, prices, veg/non-veg tags, and instantly toggle item availability (86-ing).</p>
                    <a asp-action="Menu" class="btn btn-outline-danger fw-semibold px-4">Manage Menu</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="text-success mb-3">
                        <i class="bi bi-bar-chart-line display-4"></i>
                    </div>
                    <h5 class="fw-bold">Daily Sales & Analytics</h5>
                    <p class="text-muted small">Review daily settlement reports, payment method distribution (Cash vs UPI vs Card), and top sellers.</p>
                    <a asp-controller="Reports" asp-action="DailySales" class="btn btn-outline-success fw-semibold px-4">View Reports</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="mb-3 text-info">
                        <i class="bi bi-people-fill display-4"></i>
                    </div>
                    <h5 class="fw-bold">Staff &amp; Role Management</h5>
                    <p class="text-muted small">Register Cashiers for POS billing, Kitchen Chefs for live KDS, and manage login access for your branch.</p>
                    <a asp-action="Staff" class="btn btn-outline-dark fw-semibold px-4">Manage Team &amp; Staff</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <div class="card-body p-4 text-center">
                    <div class="mb-3 text-warning">
                        <i class="bi bi-qr-code display-4"></i>
                    </div>
                    <h5 class="fw-bold">Payment QR &amp; UPI Settings</h5>
                    <p class="text-muted small">Upload your company's UPI payment QR code, configure UPI ID and Payee Name for customer diner checkout.</p>
                    <a asp-action="Settings" class="btn btn-outline-warning text-dark fw-semibold px-4">Manage Payment QR</a>
                </div>
            </div>
        </div>
    </div>
</div>
