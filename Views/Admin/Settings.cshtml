@model MenuScan.Models.Entities.Restaurant
@{
    ViewData["Title"] = "Payment & Store Settings";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Settings</li>
                </ol>
            </nav>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-qr-code text-warning me-2"></i>Payment QR &amp; UPI Settings
            </h2>
            <p class="text-muted mb-0">Configure your company's official payment scanner QR code and UPI credentials for diner checkout.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
        </div>
    </div>

    <!-- Feedback Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@TempData["Success"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left: Upload & Details Form -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary-subtle text-primary p-2 rounded-3 me-3">
                            <i class="bi bi-credit-card-2-front fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-0">Restaurant UPI &amp; QR Setup</h5>
                            <small class="text-muted">Manage the UPI account where your customers' online payments will be deposited.</small>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UpdatePaymentSettings" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <!-- UPI ID -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">
                                Business / Merchant UPI ID <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-at"></i>
                                </span>
                                <input type="text" name="upiId" value="@Model.UpiId" class="form-control border-start-0" placeholder="e.g. restaurant@okhdfcbank or 9876543210@paytm" maxlength="100" required />
                            </div>
                            <div class="form-text small">Enter your verified merchant or bank UPI VPA handle.</div>
                        </div>

                        <!-- Payee Name -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">
                                Account / Payee Display Name
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted">
                                    <i class="bi bi-shop"></i>
                                </span>
                                <input type="text" name="payeeName" value="@Model.PayeeName" class="form-control border-start-0" placeholder="e.g. @Model.Name" maxlength="150" />
                            </div>
                            <div class="form-text small">Name shown to customers on UPI payment apps (GPay, PhonePe, Paytm).</div>
                        </div>

                        <!-- File Upload -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark small">
                                Upload Official Standee / Payment QR Image
                            </label>
                            <div class="p-3 border rounded-3 bg-light text-center">
                                <input type="file" name="qrFile" id="qrFileInput" class="form-control mb-2" accept=".jpg,.jpeg,.png,.webp" onchange="previewQr(this)" />
                                <small class="text-muted d-block">
                                    Supported formats: <strong>PNG, JPG, JPEG, WEBP</strong> (Max size: 5MB).
                                </small>
                            </div>
                        </div>

                        <!-- Live File Preview Box (Hidden by default) -->
                        <div id="newQrPreviewBox" class="mb-4 d-none">
                            <label class="form-label fw-bold text-success small">Selected New QR Preview:</label>
                            <div class="text-center p-3 border border-success border-dashed rounded-3 bg-success-subtle">
                                <img id="newQrImg" src="#" alt="New QR Preview" class="img-fluid rounded-3 shadow-sm" style="max-height: 200px; object-fit: contain;" />
                                <div class="small text-success fw-semibold mt-2">
                                    <i class="bi bi-check2-circle"></i> Ready to upload upon saving
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <button type="submit" class="btn btn-warning fw-bold text-dark px-4 py-2 rounded-3 shadow-sm">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Save Payment Settings
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right: Current Active QR & Live Status -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                    <h5 class="fw-bold mb-0">Active Payment Scanner</h5>
                    <small class="text-muted">This is what your diners see on their mobile screens.</small>
                </div>
                <div class="card-body p-4 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.SafePaymentQrImageUrl))
                    {
                        <div class="p-3 bg-light rounded-4 border shadow-sm d-inline-block mb-3 position-relative" style="max-width: 280px;">
                            <img src="@Model.SafePaymentQrImageUrl" alt="Active Payment QR" class="img-fluid rounded-3" style="max-height: 250px; object-fit: contain;" />
                            <div class="badge bg-success py-1 px-3 mt-2 rounded-pill d-inline-flex align-items-center gap-1">
                                <i class="bi bi-patch-check-fill"></i> Live on Diner Bill Screen
                            </div>
                        </div>

                        <div class="mb-3 text-start bg-light p-3 rounded-3 small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Active UPI ID:</span>
                                <span class="fw-bold text-dark font-monospace">@(string.IsNullOrWhiteSpace(Model.UpiId) ? "Not set" : Model.UpiId)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Payee Name:</span>
                                <span class="fw-bold text-dark">@(string.IsNullOrWhiteSpace(Model.PayeeName) ? Model.Name : Model.PayeeName)</span>
                            </div>
                        </div>

                        <form asp-action="RemovePaymentQr" method="post" onsubmit="return confirm('Are you sure you want to remove your custom payment QR image? Diners will see default UPI QR until a new one is uploaded.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3">
                                <i class="bi bi-trash3 me-1"></i> Remove Custom QR
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="py-5 text-center">
                            <div class="text-muted opacity-50 mb-3">
                                <i class="bi bi-qr-code display-1"></i>
                            </div>
                            <h6 class="fw-bold text-dark">No Custom Payment QR Uploaded</h6>
                            <p class="text-muted small px-3">
                                Upload your Google Pay / PhonePe / Paytm merchant standee QR image on the left.
                                Once uploaded, your diners will be able to scan and pay directly from their table!
                            </p>
                        </div>
                    }

                    <!-- Info Alert -->
                    <div class="alert alert-info border-0 rounded-3 text-start small mt-4 mb-0">
                        <div class="d-flex gap-2">
                            <i class="bi bi-info-circle-fill fs-5 text-info"></i>
                            <div>
                                <strong>How Diner Payment Works:</strong>
                                <ul class="mb-0 ps-3 mt-1">
                                    <li>Customer table par QR scan karke order deta hai.</li>
                                    <li>Checkout screen par jab customer <em>Pay Online / UPI</em> select karega, unhe aapka ye uploaded QR code dikhai dega.</li>
                                    <li>Paisa direct aapke verified bank/UPI account mein deposit hota hai.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewQr(input) {
            const previewBox = document.getElementById('newQrPreviewBox');
            const previewImg = document.getElementById('newQrImg');
            
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImg.src = e.target.result;
                    previewBox.classList.remove('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            } else {
                previewBox.classList.add('d-none');
            }
        }
    </script>
}
