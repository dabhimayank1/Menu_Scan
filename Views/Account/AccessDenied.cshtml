@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="fw-bold">Access Denied</h2>
            <p class="text-muted">You do not have permission to view or manage this resource.</p>
            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary me-2">Back to Home</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Sign In with Different Account</a>
            </div>
        </div>
    </div>
</div>
