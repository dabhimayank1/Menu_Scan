@model MenuScan.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Account Security Settings";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="border: 1.5px solid var(--cafe-border) !important;">
            <div class="card-header bg-dark text-white p-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock-fill text-warning fs-4"></i>
                    <h4 class="mb-0 fw-bold">Account Security Settings</h4>
                </div>
            </div>

            <div class="card-body p-4 bg-white">
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning rounded-3 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        @TempData["Warning"]
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success rounded-3 small mb-3">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        @TempData["Success"]
                    </div>
                }

                <form asp-action="ChangePassword" method="post" id="securityForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

                    <!-- 1. Email Section -->
                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="bi bi-envelope-at text-primary me-1"></i> Email Address
                        </h6>

                        <div class="mb-3">
                            <label class="form-label small text-muted fw-semibold">Current Login Email</label>
                            <input type="text" class="form-control bg-white" value="@Model.CurrentEmail" readonly disabled />
                        </div>

                        <div>
                            <label asp-for="NewEmail" class="form-label fw-semibold small text-dark">
                                New Email Address <span class="badge bg-secondary-subtle text-secondary ms-1">Optional</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="NewEmail" type="email" class="form-control border-start-0 bg-white" placeholder="Leave blank to keep current email" maxlength="150" autocomplete="off" />
                            </div>
                            <span asp-validation-for="NewEmail" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- 2. Password Section -->
                    <div class="bg-light p-3 rounded-3 mb-4 border">
                        <h6 class="fw-bold text-dark mb-3">
                            <i class="bi bi-key-fill text-warning me-1"></i> Password
                        </h6>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold small text-dark">
                                New Password <span class="badge bg-secondary-subtle text-secondary ms-1">Optional</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-key text-muted"></i></span>
                                <input asp-for="NewPassword" type="password" class="form-control border-start-0 bg-white" id="newPasswordInput" placeholder="Leave blank to keep current password" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <div class="form-text small text-muted">Must be at least 8 characters with uppercase, lowercase, number, and special character.</div>
                        </div>

                        <div>
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-dark">
                                Confirm New Password
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-check-circle text-muted"></i></span>
                                <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 bg-white" id="confirmPasswordInput" placeholder="Re-enter new password" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- 3. Current Password (Required Verification) -->
                    <div class="mb-4">
                        <label asp-for="CurrentPassword" class="form-label fw-bold small text-dark">
                            Current Password <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock-fill text-danger"></i></span>
                            <input asp-for="CurrentPassword" type="password" class="form-control border-start-0" id="currentPasswordInput" placeholder="Enter current password to authorize changes" required autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        <div class="form-text small text-muted">Your current password is required to authorize any changes to your account.</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-cafe-primary rounded-pill px-4 fw-bold">
                            <i class="bi bi-check2-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
