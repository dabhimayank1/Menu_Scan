@model MenuScan.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden" style="border: 1.5px solid var(--cafe-border) !important;">
            <div class="card-header bg-dark text-white p-4">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-shield-lock-fill text-warning fs-4"></i>
                    <h4 class="mb-0 fw-bold">Change Password</h4>
                </div>
                <small class="text-white-50">Update your account credentials to keep your portal secure.</small>
            </div>

            <div class="card-body p-4 bg-white">
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning rounded-3 small mb-3">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        @TempData["Warning"]
                    </div>
                }

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success rounded-3 small mb-3">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        @TempData["Success"]
                    </div>
                }

                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold small text-muted">Current Password *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="CurrentPassword" type="password" class="form-control border-start-0" id="currentPasswordInput" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small text-muted">New Secure Password *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                            <input asp-for="NewPassword" type="password" class="form-control border-start-0" id="newPasswordInput" placeholder="Minimum 8 characters" required />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text small text-muted">Must include uppercase, lowercase, number, and special character.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-muted">Confirm New Password *</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-check-circle text-muted"></i></span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0" id="confirmPasswordInput" placeholder="Re-type new password" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                        <button type="submit" class="btn btn-cafe-primary rounded-pill px-4 fw-bold">Update Password</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
