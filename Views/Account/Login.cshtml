@model MenuScan.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Staff Login";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="border: 1.5px solid var(--cafe-border) !important;">
            <div class="cafe-promo-banner text-center py-4 rounded-0">
                <span class="fs-2 mb-1 d-block">☕</span>
                <h4 class="mb-0 fw-bold text-white">Staff Portal Login</h4>
                <small class="text-white-50">Brew &amp; Bliss Coffee House</small>
            </div>
            <div class="card-body p-4 bg-white">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small text-muted">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control border-start-0" id="emailInput" placeholder="name@brewandbliss.com" required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold small text-muted">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                            <input asp-for="Password" type="password" class="form-control border-start-0" id="passwordInput" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted">Remember my session</label>
                    </div>

                    <button type="submit" class="btn btn-cafe-primary w-100 py-2 fw-bold">Sign In</button>
                </form>

                <hr class="my-4" />

                <div>
                    <h6 class="text-muted text-center small fw-bold mb-3">QUICK-FILL TEST ACCOUNTS</h6>
                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-dark btn-sm text-start rounded-pill py-2" onclick="fillCreds('manager@spicesymphony.com', 'Staff@123')">
                            <strong>Restaurant Admin</strong> <span class="badge bg-secondary ms-2">Full Store Access</span>
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm text-start rounded-pill py-2" onclick="fillCreds('cashier@spicesymphony.com', 'Staff@123')">
                            <strong>Cashier / Billing</strong> <span class="badge bg-primary ms-2">Orders &amp; Bills</span>
                        </button>
                        <button type="button" class="btn btn-outline-warning btn-sm text-start text-dark rounded-pill py-2" onclick="fillCreds('kitchen@spicesymphony.com', 'Staff@123')">
                            <strong>Kitchen / Barista</strong> <span class="badge bg-warning text-dark ms-2">KDS Display</span>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm text-start rounded-pill py-2" onclick="fillCreds('admin@menuscan.com', 'Admin@123')">
                            <strong>Super Admin</strong> <span class="badge bg-dark ms-2">Platform Owner</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(email, pwd) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = pwd;
        }
    </script>
}
