@{
    ViewData["Title"] = "Brew & Bliss Coffee House - Smart QR Ordering";
}

<div class="container py-5">
    <div class="row align-items-center mb-5 g-5">
        <div class="col-lg-7">
            <span class="badge rounded-pill px-3 py-2 fw-semibold mb-3" style="background-color: var(--cafe-primary-light); color: var(--cafe-primary);">
                ☕ Artisan Coffee &amp; Kitchen Management System
            </span>
            <h1 class="display-4 fw-bold lh-sm mb-3" style="letter-spacing: -1px;">
                Good Coffee.<br />Good Vibes.<br />Smart Table Ordering.
            </h1>
            <p class="lead text-muted mb-4" style="font-size: 17px; line-height: 1.6;">
                Customers scan a table QR code and browse our artisan coffee, breakfast, and snack catalog in mobile or desktop view. Orders instantly chime on the barista & kitchen screen and sync to billing!
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a href="/r/spice-symphony/t/TAB-01" class="btn btn-cafe-primary btn-lg px-4 fw-bold">
                    <i class="bi bi-cup-hot me-2"></i> Launch Customer Menu (Table 1)
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-cafe-outline btn-lg px-4 fw-bold">
                    <i class="bi bi-shield-lock me-2"></i> Staff Portal Login
                </a>
            </div>
        </div>
        
        <div class="col-lg-5 text-center">
            <div class="card shadow-lg border-0 rounded-4 p-4 bg-white d-inline-block w-100" style="border: 1.5px solid var(--cafe-border) !important;">
                <span class="badge bg-dark rounded-pill px-3 py-1 mb-3">TABLE QR STAND</span>
                <div class="p-3 border rounded-4 bg-light d-inline-block mb-3">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=http://192.168.1.8:5073/r/spice-symphony/t/TAB-01" 
                         alt="Table 1 QR Code" class="img-fluid" style="width: 190px; height: 190px;" />
                </div>
                <h5 class="fw-bold text-dark mb-1">Brew &amp; Bliss Coffee House</h5>
                <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1 mb-2">
                    Table 1 (Active)
                </span>
                <p class="small text-muted mb-0"><strong>Scan with your smartphone camera</strong> to open the menu on your phone!</p>
            </div>
        </div>
    </div>

    <!-- 3 Pillars -->
    <div class="row g-4 pt-3">
        <div class="col-md-4">
            <div class="cafe-product-card p-4">
                <div class="mb-3 text-warning">
                    <i class="bi bi-phone display-5" style="color: var(--cafe-primary);"></i>
                </div>
                <h5 class="fw-bold">1. Digital Menu & Cart</h5>
                <p class="text-muted small mb-0">
                    Dual-responsive design: sleek mobile experience with promo carousel and circular categories, or expansive tablet/desktop layout with live cart summary.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="cafe-product-card p-4">
                <div class="mb-3">
                    <i class="bi bi-fire display-5 text-danger"></i>
                </div>
                <h5 class="fw-bold">2. Kitchen & Barista KDS</h5>
                <p class="text-muted small mb-0">
                    Real-time WebSocket notifications with synthesized chime alerts. Chefs and baristas transition tickets seamlessly without screen refreshes.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="cafe-product-card p-4">
                <div class="mb-3">
                    <i class="bi bi-receipt-cutoff display-5 text-success"></i>
                </div>
                <h5 class="fw-bold">3. Cashier & Receipts</h5>
                <p class="text-muted small mb-0">
                    Reconcile table bills, compute taxes automatically, record payments (Cash/UPI/Card), and print 80mm thermal receipts.
                </p>
            </div>
        </div>
    </div>
</div>
